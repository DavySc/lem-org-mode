;;; Table formulas

(check "cell number" '(12 3.5d0 -2 1000.0d0 nil nil nil) (mapcar #'cell-number '("12" "3.5" "-2" "1e3" "abc" "" "-")))
(check "format integer" "7" (format-calc-number 7))
(check "format ratio" "0.333333333333" (format-calc-number 1/3))
(check "format float integer" "3" (format-calc-number 3.0d0))
(check "format simple decimal" "2.5" (format-calc-number 5/2))
(check "format spec f" "3.14" (format-calc-number 3.14159d0 "%.2f"))
(check "format spec d" "4" (format-calc-number 3.6d0 "%d"))
(check "format large" "1234567.5" (format-calc-number 2469135/2))
(check "format negative small" "-0.25" (format-calc-number -1/4))

(defun calc (text &optional (rows '(("1" "2" "3") ("4" "5" "6") ("7" "8" "9"))) (row 1) (column 1))
  (formula-eval (formula-parse text) (make-sheet rows) row column))
(check "arithmetic" 14 (calc "2+3*4"))
(check "parentheses and power" 25 (calc "(2+3)^2"))
(check "power is right associative" 512 (calc "2^3^2"))
(check "unary minus" -5 (calc "-5"))
(check "division is exact" 1/3 (calc "1/3"))
(check "modulo" 1 (calc "7%3"))
(check "field in the current row" 3 (calc "$3"))
(check "field of another row" 6 (calc "@2$3"))
(check "relative rows" 1 (calc "@-1$1" '(("1") ("2")) 2))
(check "last row and column" 9 (calc "@>$>"))
(check "second last row" 4 (calc "@>>$1"))
(check "first row" 3 (calc "@<$3" '(("1" "2" "3") ("4" "5" "6")) 2))
(check "sum of a column range" 12 (calc "vsum(@1$1..@3$1)"))
(check "sum of a row range" 6 (calc "vsum($1..$3)"))
(check "mean" 5 (calc "vmean(@1$1..@3$3)"))
(check "max and min" '(9 1) (list (calc "vmax(@1$1..@3$3)") (calc "vmin(@1$1..@3$3)")))
(check "count" 9 (calc "vcount(@1$1..@3$3)"))
(check "median" 5 (calc "vmedian(@1$1..@3$3)"))
(check "if" '(1 0) (list (calc "if($1>0,1,0)") (calc "if($1>5,1,0)")))
(check "comparison and logic" 1 (calc "$1<$2&&$2<$3"))
(check "functions" '(2 2 3) (list (calc "abs(-2)") (calc "floor(2.7)") (calc "ceiling(2.1)")))
(check "round with digits" 157/50 (calc "round(3.14159,2)"))
(check "empty cell counts as 0" 4 (calc "$1+$2" '(("4" "")) 1))
(check "rule rows are not counted" 2 (calc "@2$2" '(("a" "b") :rule ("1" "2") ("4" "5")) 2))
(check "range between rules" 6 (calc "vsum(@I..@II)" '(("h") :rule ("1") ("2") ("3") :rule ("total")) 5))
(check-error "unknown function" (calc "frobnicate(1)"))
(check-error "bad token" (calc "1 $ 2"))
(check-error "dangling operator" (calc "1+"))
(check-error "division by zero" (calc "1/0"))
(check "tokenizer" '(1 "+" (:field "@2$3")) (formula-tokenize "1+@2$3"))

(defun recalc (rows &rest formulas) (table-recalculate-rows rows formulas))
(check "column formula" '(("2" "3" "6") ("4" "5" "20")) (recalc '(("2" "3" "") ("4" "5" "")) "$3=$1*$2"))
(check "column formula formats" '(("1" "3" "0.33")) (recalc '(("1" "3" "")) "$3=$1/$2;%.2f"))
(check "column formula skips the header" '(("a" "b") :rule ("1" "2") ("3" "4")) 
       (recalc '(("a" "b") :rule ("1" "") ("3" "")) "$2=$1+1"))
(check "column formula in a table with a total row" '(("n" "d") :rule ("1" "2") ("2" "4") :rule ("3" ""))
       (recalc '(("n" "d") :rule ("1" "") ("2" "") :rule ("3" "")) "$2=$1*2"))
(check "field formula" '(("1" "2") ("3" "7")) (recalc '(("1" "2") ("3" "")) "@2$2=7"))
(check "total row" '(("1") ("2") ("3")) (recalc '(("1") ("2") ("")) "@3$1=vsum(@1..@-1)"))
(check "formulas in order" '(("2" "3" "5")) (recalc '(("2" "" "")) "$2=$1+1" "$3=$1+$2"))
(check "range target" '(("1" "9" "9") ("2" "9" "9")) (recalc '(("1" "" "") ("2" "" "")) "@1$2..@2$3=9"))
(check "row formula" '(("5" "5" "5")) (recalc '(("" "" "")) "@1=5"))
(check "error cell" '(("x" "#ERROR")) (recalc '(("x" "")) "$2=$1*2"))
(check "tblfm split" '("$3=$1*$2" "@>$1=vsum(@I..@>>)") (tblfm-split "#+TBLFM: $3=$1*$2::@>$1=vsum(@I..@>>)"))
(check "tblfm line" '(t nil) (list (tblfm-line-p "#+TBLFM: $1=1") (tblfm-line-p "#+TITLE: x")))
(check "sum of a column" "7.5" (column-sum-text '("1" "2.5" "x" "4" "")))
(check "split lines at tabs" '(("a" "b") ("c" "d")) (lines-to-rows (list (format nil "a	b") (format nil "c	d"))))
(check "split lines at commas" '(("a" "b") ("c" "d")) (lines-to-rows '("a,b" "c, d")))
(check "split lines at blanks" '(("a" "b") ("c")) (lines-to-rows '("a  b" "" "c")))
(check "delimited output" '("a,\"b,c\"" "1,2") (rows-to-delimited '(("a" "b,c") :rule ("1" "2")) #\,))
