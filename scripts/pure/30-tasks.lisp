;;; Tasks: sequences, logging, repeats, cookies

(defvar *seqs* (todo-sequences-from-lines (list "#+TITLE: x" "#+TODO: TODO(t) NEXT(n!) | DONE(d@/!) CANCELED(c@)" "#+TYP_TODO: Fred Sara | Lance")
                                          (todo-sequences-from-setting '("TODO" "DONE"))))
(check "two sequences" 2 (length *seqs*))
(check "keywords" '("TODO" "NEXT" "DONE" "CANCELED" "Fred" "Sara" "Lance") (sequences-keywords *seqs*))
(check "done keywords" '("DONE" "CANCELED" "Lance") (sequences-done-keywords *seqs*))
(check "done-p" '(t nil) (list (sequences-done-p *seqs* "DONE") (sequences-done-p *seqs* "NEXT")))
(check "keys" '((#\t . "TODO") (#\n . "NEXT") (#\d . "DONE") (#\c . "CANCELED")) (sequences-key-alist *seqs*))
(check "log flags" '(:note :time) (multiple-value-list (sequences-log *seqs* "DONE")))
(check "log flags enter only" '(:time nil) (multiple-value-list (sequences-log *seqs* "NEXT")))
(check "no log flags" '(nil nil) (multiple-value-list (sequences-log *seqs* "TODO")))
(check "cycle forward" '("TODO" "NEXT" "DONE" "CANCELED" nil) 
       (let ((s nil) (out '())) (dotimes (i 5) (setf s (sequences-next *seqs* s 1)) (push s out)) (nreverse out)))
(check "cycle backward from none" "Lance" (sequences-next *seqs* nil -1))
(check "cycle in the second sequence" '("Sara" "Lance" nil) 
       (let ((s "Fred") (out '())) (dotimes (i 3) (setf s (sequences-next *seqs* s 1)) (push s out)) (nreverse out)))
(check "backward from first is none" nil (sequences-next *seqs* "TODO" -1))
(check "first todo of the sequence" "Fred" (sequences-first-todo *seqs* "Lance"))
(check "default sequences" '("TODO" "DONE") (sequences-keywords (todo-sequences-from-setting nil)))
(check "setting with bar" '(:todo ("TODO" "NEXT") :done ("DONE") :keys nil :log nil)
       (first (todo-sequences-from-setting '("TODO" "NEXT" "|" "DONE"))))
(check "setting with several sequences" 2 (length (todo-sequences-from-setting '(("TODO" "|" "DONE") ("A" "B")))))
(check "setting with sequence marker" '("A" "B") (sequences-keywords (todo-sequences-from-setting '((sequence "A" "|" "B")))))

(check "log state line" "- State \"DONE\"       from \"TODO\"       [2026-10-22 Thu 10:00]"
       (log-state-text "DONE" "TODO" "[2026-10-22 Thu 10:00]"))
(check "log with note" '("- State \"DONE\"       from \"TODO\"       [2026-10-22 Thu 10:00] \\\\" "  finished")
       (log-entry-lines (log-state-text "DONE" "TODO" "[2026-10-22 Thu 10:00]") "finished"))
(check "logbook created" '(":LOGBOOK:" "- x" ":END:") (logbook-add nil '("- x") "LOGBOOK"))
(check "logbook on top" '(":LOGBOOK:" "- y" "CLOCK: [..]" ":END:") (logbook-add '(":LOGBOOK:" "CLOCK: [..]" ":END:") '("- y") "LOGBOOK"))

(check "planning repeat" '((("SCHEDULED" . "<2026-10-29 Thu +1w>") ("DEADLINE" . "<2026-10-23 Fri>")) t)
       (multiple-value-list (planning-with-repeat '(("SCHEDULED" . "<2026-10-22 Thu +1w>") ("DEADLINE" . "<2026-10-23 Fri>")) *d* nil)))
(check "text repeat" '("a <2026-10-29 Thu +1w> b [2026-10-22 Thu +1w] c" t)
       (multiple-value-list (text-with-repeat "a <2026-10-22 Thu +1w> b [2026-10-22 Thu +1w] c" *d* nil)))
(check "no repeat" '("<2026-10-22 Thu>" nil) (multiple-value-list (text-with-repeat "<2026-10-22 Thu>" *d* nil)))
(check "entry repeats" '(t nil) (list (entry-repeats-p '("* TODO x" "SCHEDULED: <2026-10-22 Thu +1d>")) (entry-repeats-p '("* TODO x" "SCHEDULED: <2026-10-22 Thu>"))))

(check "cookie find count" '(4 9 :count) (multiple-value-list (cookie-find "* a [1/3] b")))
(check "cookie find percent" '(4 7 :percent) (multiple-value-list (cookie-find "* a [%] b")))
(check "checkbox is not a cookie" nil (cookie-find "- [X] item"))
(check "link is not a cookie" nil (cookie-find "[[foo][bar]]"))
(check "cookie render" '("[1/3]" "[33%]" "[0%]") (list (cookie-render :count 1 3) (cookie-render :percent 1 3) (cookie-render :percent 0 0)))
(check "line with cookie" "* a [2/3] b" (line-with-cookie "* a [/] b" 2 3))
(defvar *tree* '("* Project [0/0]" "** TODO a" "** DONE b" "*** TODO c" "** NEXT d" "* Other [%]" "- [X] one" "- [ ] two" "- [X] three"))
(check "heading stats count direct children" '(1 3) (multiple-value-list (heading-cookie-stats *tree* 0 '("TODO" "NEXT" "DONE") '("DONE"))))
(check "heading stats from checkboxes" '(2 3) (multiple-value-list (heading-cookie-stats *tree* 5 '("TODO" "NEXT" "DONE") '("DONE"))))
(check "cookies after a change" '((0 . "* Project [1/3]") (5 . "* Other [66%]"))
       (let ((c1 (cookies-update *tree* 2 '("TODO" "NEXT" "DONE") '("DONE")))
             (c2 (cookies-update *tree* 7 '("TODO" "NEXT" "DONE") '("DONE"))))
         (list (assoc 0 c1) (assoc 5 c2))))
(defvar *items* '("* H [0/0]" "- [ ] parent [0/2]" "  - [X] a" "  - [ ] b" "- [ ] other"))
(check "parent checkbox and cookie follow children" '((1 . "- [-] parent [1/2]") (0 . "* H [0/2]"))
       (let ((c (cookies-update *items* 2 '("TODO" "DONE") '("DONE")))) (list (assoc 1 c) (assoc 0 c))))
(check "all done checks the parent" "- [X] parent [2/2]"
       (cdr (assoc 0 (cookies-update '("- [ ] parent [0/2]" "  - [X] a" "  - [X] b") 1 '("TODO" "DONE") '("DONE")))))
(check "update all" '((0 . "* P [1/2]") (3 . "* Q [100%]"))
       (cookies-update-all '("* P [/]" "** TODO a" "** DONE b" "* Q [%]" "- [X] z") '("TODO" "DONE") '("DONE")))
