;;; Editing: templates, lists, comment, timer

(check "src template" '("#+begin_src " "" "#+end_src") (structure-template-lines "src" (list "") 0))
(check "quote template with indent" '("  #+begin_quote" "" "  #+end_quote") (structure-template-lines "quote" (list "") 2))
(check "export template keeps the type in begin only" '("#+begin_export html" "x" "#+end_export") (structure-template-lines "export html" (list "x") 0))
(check "wrap body" '("#+begin_example" "a" "b" "#+end_example") (structure-template-lines "example" (list "a" "b") 0))
(check "tempo" '(("#+begin_src " "" "#+end_src") 1) (multiple-value-list (tempo-expand "<s" *org-structure-template-alist*)))
(check "tempo indented" '(("  #+begin_quote" "" "  #+end_quote") 1) (multiple-value-list (tempo-expand "  <q" *org-structure-template-alist*)))
(check "tempo unknown" nil (tempo-expand "<zz" *org-structure-template-alist*))
(check "tempo not a shortcut" nil (tempo-expand "a <s" *org-structure-template-alist*))

(defvar *li* '("- a" "  - a1" "  - a2" "- b" "- c"))
(check "indent an item with its children" '("- a" "  - a1" "  - a2" "  - b" "- c") (list-indent-item (list "- a" "  - a1" "  - a2" "- b" "- c") 3 2))
(check "indent carries children" '("- a" "  - b" "    - b1" "- c") (list-indent-item (list "- a" "- b" "  - b1" "- c") 1 2))
(check "outdent" '("- a" "- b" "- c") (list-indent-item (list "- a" "  - b" "- c") 1 -2))
(check-error "outdent at the margin" (list-indent-item (list "- a") 0 -2))
(check "move item up" '(("- b" "- a" "  - a1" "- c") 0) (multiple-value-list (list-move-item (list "- a" "  - a1" "- b" "- c") 2 -1)))
(check "move item down carries its children" '(("- b" "- a" "  - a1" "- c") 1) (multiple-value-list (list-move-item (list "- a" "  - a1" "- b" "- c") 0 1)))
(check-error "move the first item up" (list-move-item (list "- a" "- b") 0 -1))
(check-error "move the last item down" (list-move-item (list "- a" "- b") 1 1))
(check "move a nested item" '(("- p" "  - y" "  - x") 2) (multiple-value-list (list-move-item (list "- p" "  - x" "  - y") 1 1)))
(check "bullet cycle" '("+ a" "1. a" "1) a" "- a") (let ((l "- a") (out '())) (dotimes (i 4) (setf l (list-cycle-bullet-line l)) (push l out)) (nreverse out)))
(check "bullet cycle keeps indent and checkbox" "  + [ ] a" (list-cycle-bullet-line "  - [ ] a"))
(check "make item" "  - text" (line-make-item "  text"))
(check "list shift" '("    a" "" "  b") (list-shift-lines '("  a" "" "b") 2))
(check "comment toggle on" "* TODO COMMENT x" (heading-toggle-comment "* TODO x" '("TODO")))
(check "comment toggle off" "* TODO x" (heading-toggle-comment "* TODO COMMENT x" '("TODO")))
(check "comment toggle keeps tags" '(t t) (let ((r (heading-toggle-comment "* x :t:" '("TODO")))) (list (and (search "COMMENT x" r) t) (and (search ":t:" r) t))))
(check "timer text" "1:02:03" (format-timer-seconds 3723))
(check "timer elapsed" '(100 55 nil) (list (timer-elapsed 0 nil 100) (timer-elapsed 0 55 100) (timer-elapsed nil nil 100)))
