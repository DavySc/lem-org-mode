;;; Structure: levels, archive, sorting, dependencies

(defvar *sk* '("TODO" "NEXT" "DONE"))
(check "shift levels down" '("** A" "*** B" "text") (lines-shift-levels '("* A" "** B" "text") 1 *sk*))
(check "shift levels up keeps level 1" '("* A" "* B") (lines-shift-levels '("** A" "* B") -1 *sk*))
(check "shift levels leaves blocks alone" '("** A" "#+begin_src sh" "* not" "#+end_src") (lines-shift-levels '("* A" "#+begin_src sh" "* not" "#+end_src") 1 *sk*))
(check "archive location default" '("/tmp/notes.org_archive" nil) (multiple-value-list (archive-location-parse "%s_archive::" "/tmp/notes.org")))
(check "archive location heading" '(nil "* Archived") (multiple-value-list (archive-location-parse "::* Archived" "/tmp/notes.org")))
(check "archive location file and heading" '("old.org" "Done") (multiple-value-list (archive-location-parse "old.org::Done" nil)))
(check "archived subtree has properties" '("** TODO x" ":PROPERTIES:" ":ARCHIVE_TIME: 2026-10-22 Thu 10:00" ":ARCHIVE_FILE: a.org" ":END:" "body")
       (subtree-for-archive '("* TODO x" "body") 1 '(("ARCHIVE_TIME" . "2026-10-22 Thu 10:00") ("ARCHIVE_FILE" . "a.org")) *sk*))
(check "archive keeps planning" '("* TODO x" "SCHEDULED: <2026-10-22 Thu>" ":PROPERTIES:" ":A: 1" ":END:")
       (subtree-for-archive '("* TODO x" "SCHEDULED: <2026-10-22 Thu>") 0 '(("A" . "1")) *sk*))

(defvar *entries-text* '("* TODO [#C] banana 10" "* NEXT [#A] apple 2" "** child" "* DONE cherry 33" "* plain"))
(defun sorted-heads (kind &optional reverse)
  (mapcar (lambda (l) (nth-value 3 (heading-split l *sk*)))
          (remove-if-not (lambda (l) (heading-split l *sk*)) (remove "** child" (sort-subtree-lines *entries-text* 1 kind reverse *sk*) :test #'string=))))
(check "sort alpha" '("apple 2" "banana 10" "cherry 33" "plain") (sorted-heads :alpha))
(check "sort alpha reversed" '("plain" "cherry 33" "banana 10" "apple 2") (sorted-heads :alpha t))
(check "sort numeric" '("plain" "apple 2" "banana 10" "cherry 33") (sorted-heads :numeric))
(check "sort priority" '("apple 2" "cherry 33" "plain" "banana 10") (sorted-heads :priority))
(check "sort todo state" '("banana 10" "apple 2" "cherry 33" "plain") (sorted-heads :todo))
(check "sort is stable without keys" '("banana 10" "apple 2" "cherry 33" "plain") (sorted-heads :time))
(check "children move with their parent" '("* NEXT [#A] apple 2" "** child")
       (subseq (sort-subtree-lines *entries-text* 1 :alpha nil *sk*) 0 2))
(check "sort list" '("- apple" "- banana" "  more banana" "- cherry") (sort-list-lines '("- cherry" "- banana" "  more banana" "- apple") :alpha nil))
(check "sort numbered list numerically" '("1. 2 b" "2. 10 a") (sort-list-lines '("1. 10 a" "2. 2 b") :numeric nil))
(check "sort table rows" '(("a" "2") :rule ("b" "1")) (sort-table-rows '(("b" "1") :rule ("a" "2")) 0 :alpha nil))
(check "sort table numeric column" '(("x" "1") ("y" "3") ("z" "10")) (sort-table-rows '(("y" "3") ("z" "10") ("x" "1")) 1 :numeric nil))
(check "sort table reverse" '(("z" "10") ("y" "3") ("x" "1")) (sort-table-rows '(("y" "3") ("z" "10") ("x" "1")) 1 :numeric t))
(check "sort kinds" '(:alpha t :numeric nil) (append (multiple-value-list (parse-sort-kind #\A)) (multiple-value-list (parse-sort-kind #\n))))

(defvar *dep* '("* TODO Parent" "** TODO one" "** DONE two" "* Ordered" ":PROPERTIES:" ":ORDERED: t" ":END:" "** TODO first" "** TODO second"))
(check "parent is blocked by open child" t (and (search "open child" (entry-blocked-reason *dep* 0 *sk* '("DONE"))) t))
(check "finished child is free" nil (entry-blocked-reason *dep* 2 *sk* '("DONE")))
(check "ordered sibling is blocked" t (and (search "earlier sibling" (entry-blocked-reason *dep* 8 *sk* '("DONE"))) t))
(check "first ordered sibling is free" nil (entry-blocked-reason *dep* 7 *sk* '("DONE")))
(check "sparse record" "L2 ** Parent > TODO one" (car (sparse-record (list :line 2 :level 2 :path '("Parent") :todo "TODO" :title "one"))))
