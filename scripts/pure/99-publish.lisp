;;; Publishing

(check "extension alternatives" '(t t nil) (list (extension-regexp-match-p "org" "org\\|md") (extension-regexp-match-p "md" "org\\|md") (extension-regexp-match-p "orgx" "org")))
(check "extension plain bar" t (extension-regexp-match-p "png" "png|jpg"))
(check "select files" '("/b/a.org" "/b/sub/c.org")
       (publish-select-files '("/b/a.org" "/b/x.txt" "/b/sub/c.org" "/b/private/d.org") "/b" "org" "^private/" nil))
(check "select with include" '("/b/a.org" "/b/extra.txt") (publish-select-files '("/b/a.org") "/b" "org" nil '("extra.txt")))
(check "output path" "/out/sub/c.html" (publish-output-path "/b/sub/c.org" "/b/" "/out/" "html"))
(check "output path keeps the name for attachments" "/out/img/p.png" (publish-output-path "/b/img/p.png" "/b" "/out" nil))
(check "function kinds" '(:html :markdown :attachment :latex :ics :ascii)
       (mapcar #'publish-function-kind '(org-html-publish-to-html org-md-publish-to-md org-publish-attachment org-latex-publish-to-latex org-icalendar-publish-to-ics org-ascii-publish-to-txt)))
(check-error "unknown function" (publish-function-kind 'frobnicate))
(check "extensions" '("html" "md" nil) (mapcar #'publish-extension '(:html :markdown :attachment)))
(defvar *projects* '(("site" :base-directory "/b" :publishing-directory "/o") ("static" :base-directory "/s") ("all" :components ("site" "static"))
                     ("nest" :components ("all"))))
(check "components" '("site" "static") (publish-expand-components "all" *projects*))
(check "nested components" '("site" "static") (publish-expand-components "nest" *projects*))
(check "plain project" '("site") (publish-expand-components "site" *projects*))
(check-error "unknown project" (publish-expand-components "nope" *projects*))
(check-error "cyclic project" (publish-expand-components "a" '(("a" :components ("b")) ("b" :components ("a")))))
(check "extra lines" '("#+OPTIONS: toc:nil num:t H:2" "#+HTML_HEAD: <x>" "#+AUTHOR: Me")
       (publish-extra-lines '(:with-toc nil :section-numbers t :headline-levels 2 :html-head "<x>" :author "Me")))
(check "no extra lines" nil (publish-extra-lines '(:base-directory "/b")))
(check "file title" '("Hi" "fallback") (list (file-title '("#+TITLE: Hi") "x") (file-title '("text") "fallback")))
(check "sitemap list" '("#+TITLE: Site" "" "- [[file:a.org][A]]" "- [[file:sub/b.org][B]]")
       (sitemap-lines '(("a.org" . "A") ("sub/b.org" . "B")) "Site" :style :list))
(check "sitemap tree" '("#+TITLE: Site" "" "- [[file:a.org][A]]" "- sub" "  - [[file:sub/b.org][B]]" "  - [[file:sub/c.org][C]]")
       (sitemap-lines '(("a.org" . "A") ("sub/b.org" . "B") ("sub/c.org" . "C")) "Site" :style :tree))
(check "sitemap nested directories" '("#+TITLE: S" "" "- d" "  - e" "    - [[file:d/e/f.org][F]]")
       (sitemap-lines '(("d/e/f.org" . "F")) "S" :style :tree))
(check "sitemap sort alphabetically" '("a.org" "B.org" "c.org") (mapcar #'first (sitemap-sort '(("c.org" "" 1) ("a.org" "" 2) ("B.org" "" 3)) :alphabetically)))
(check "sitemap sort chronologically" '("c.org" "a.org") (mapcar #'first (sitemap-sort '(("a.org" "" 2) ("c.org" "" 1)) :chronologically)))
(check "sitemap anti-chronologically" '("a.org" "c.org") (mapcar #'first (sitemap-sort '(("c.org" "" 1) ("a.org" "" 2)) :anti-chronologically)))
(check "sitemap folders first" '("d/x.org" "a.org") (mapcar #'first (sitemap-sort '(("a.org" "" 1) ("d/x.org" "" 2)) :alphabetically :folders :first)))
(check "sitemap folders last" '("a.org" "d/x.org") (mapcar #'first (sitemap-sort '(("d/x.org" "" 2) ("a.org" "" 1)) :alphabetically :folders :last)))
