;;; Plain text, LaTeX, Org, iCalendar, subtrees

(defun ascii-of (&rest lines) (export-ascii lines *ek*))
(defun latex-of (&rest lines) (export-latex lines *ek* :body-only t))
(defun latex-doc (&rest lines) (export-latex lines *ek*))

(check "wrap" '("aaa bbb" "ccc") (wrap-words "aaa bbb ccc" 8))
(check "wrap with indent" '("  aaa" "  bbb") (wrap-words "aaa bbb" 6 2))
(check "wrap keeps long words" '("verylongword") (wrap-words "verylongword" 4))
(check "ascii title and heading" (format nil "Doc~%===~%~%1 Intro~%=======~%~%text") (string-right-trim '(#\newline) (ascii-of "#+TITLE: Doc" "#+OPTIONS: toc:nil" "* Intro" "text")))
(check "ascii underline levels" t (let ((text (ascii-of "#+OPTIONS: toc:nil" "* A" "** B" "*** C"))) (and (has text "1 A") (has text "1.1 B") (has text "-----") (has text "~~~~~~~") t)))
(check "ascii wraps paragraphs" t (let ((*org-ascii-text-width* 20)) (every (lambda (l) (<= (length l) 20)) (split-text-lines (ascii-of "#+OPTIONS: toc:nil" "This is a rather long paragraph of plain words to wrap.")))))
(check "ascii list" t (let ((text (ascii-of "- one" "  - two" "- three"))) (and (has text "- one") (has text "   - two") (has text "- three") t)))
(check "ascii numbered list" t (has (ascii-of "1. a" "2. b") "2. b"))
(check "ascii links show the url" t (has (ascii-of "[[https://x.org][site]]") "site (https://x.org)"))
(check "ascii code is indented" t (has (ascii-of "#+begin_src sh" "ls" "#+end_src") "     ls"))
(check "ascii footnotes" t (let ((text (ascii-of "A[fn:1]" "" "[fn:1] note"))) (and (has text "A[1]") (has text "Footnotes") (has text "[1] note") t)))
(check "ascii rule" t (has (ascii-of "-----") "------------------------"))
(check "ascii toc" t (has (ascii-of "* One" "** Two") "Table of Contents"))

(check "latex escape" "a \\& b \\% c \\$ d \\# e \\_ f \\{g\\}" (latex-escape "a & b % c $ d # e _ f {g}"))
(check "latex section" t (has (latex-of "* One" "text" "** Sub") "\\section{One}"))
(check "latex subsection" t (has (latex-of "* One" "** Sub") "\\subsection{Sub}"))
(check "latex unnumbered" t (has (latex-of "#+OPTIONS: num:nil" "* One") "\\section*{One}"))
(check "latex report class uses chapters" t (has (latex-of "#+LATEX_CLASS: report" "* One") "\\chapter{One}"))
(check "latex emphasis" "\\textbf{b} \\emph{i} \\uline{u} \\texttt{c} \\sout{s}" (export-inline "*b* /i/ _u_ ~c~ +s+" :latex))
(check "latex link" "\\href{https://x.org}{X}" (export-inline "[[https://x.org][X]]" :latex))
(check "latex entities and scripts" "\\ensuremath{\\alpha}\\textsubscript{2}" (export-inline "\\alpha_{2}" :latex))
(check "latex lists" t (let ((text (latex-of "- a" "- b"))) (and (has text "\\begin{itemize}") (has text "\\item a") (has text "\\end{itemize}") t)))
(check "latex enumerate" t (has (latex-of "1. a") "\\begin{enumerate}"))
(check "latex description" t (has (latex-of "- term :: text") "\\item[term] text"))
(check "latex table" t (let ((text (latex-of "| a | 1 |" "|---+---|" "| b | 2 |"))) (and (has text "\\begin{tabular}{lr}") (has text "a & 1 \\\\") (has text "\\end{tabular}") t)))
(check "latex table with caption" t (has (latex-of "#+CAPTION: Data" "| a |") "\\caption{Data}"))
(check "latex verbatim" t (has (latex-of "#+begin_src sh" "ls" "#+end_src") "\\begin{verbatim}"))
(check "latex quote" t (has (latex-of "#+begin_quote" "q" "#+end_quote") "\\begin{quote}"))
(check "latex footnote is inline" t (has (latex-of "A[fn:1]" "" "[fn:1] note") "A\\footnote{note}"))
(check "latex figure" t (has (latex-of "#+CAPTION: Cat" "[[file:cat.png]]") "\\includegraphics"))
(check "latex raw" t (has (latex-of "#+LATEX: \\clearpage") "\\clearpage"))
(check "latex export block" t (has (latex-of "#+begin_export latex" "\\vspace{1cm}" "#+end_export") "\\vspace{1cm}"))
(check "latex math" t (has (latex-of "$x^2$") "\\(x^2\\)"))
(check "latex document" t (let ((text (latex-doc "#+TITLE: T" "#+AUTHOR: Me" "#+LATEX_HEADER: \\usepackage{foo}" "* One"))) (and (has text "\\documentclass[11pt]{article}") (has text "\\title{T}") (has text "\\author{Me}") (has text "\\usepackage{foo}") (has text "\\begin{document}") (has text "\\maketitle") (has text "\\tableofcontents") (has text "\\end{document}") t)))
(check "latex class options" t (has (latex-doc "#+LATEX_CLASS_OPTIONS: [a4paper]" "x") "\\documentclass[a4paper]{article}"))
(check "latex todo keyword" t (has (latex-of "* TODO Task") "\\textbf{TODO} Task"))

(check "org export expands includes and macros" (format nil "#+MACRO: hi Hello $1~%A Hello Bob~%* H~%") (export-org '("#+MACRO: hi Hello $1" "A {{{hi(Bob)}}}" "* H") *ek*))
(check "org export drops excluded trees" (format nil "* Keep~%") (export-org '("* Keep" "* Gone :noexport:" "x") *ek*))

(check "ical escape" "a\\, b\\; c\\nd\\\\" (ical-escape (format nil "a, b; c~%d\\")))
(check "ical fold" t (let ((folded (ical-fold (make-string 100 :initial-element #\a)))) (and (= 75 (position #\return folded)) (char= #\space (char folded 77)) t)))
(check "ical date" "20261022" (ical-date (timestamp-parse "<2026-10-22 Thu>")))
(check "ical rrule" "RRULE:FREQ=WEEKLY;INTERVAL=2" (ical-rrule '(:cumulate 2 :w)))
(defvar *ical-entries* (agenda-parse (list "* TODO Dentist :health:" "SCHEDULED: <2026-10-22 Thu 10:00-11:00 +1w> DEADLINE: <2026-10-30 Fri>"
                                           "* Trip" "<2026-11-02 Mon>--<2026-11-04 Wed>" "* Meet" "<2026-11-05 Thu 14:30>") *ek* "x.org"))
(defvar *ical* (export-icalendar *ical-entries* :now '(2026 10 22 8 0) :name "My cal"))
(check "ical frame" t (and (has *ical* "BEGIN:VCALENDAR") (has *ical* "END:VCALENDAR") (has *ical* "X-WR-CALNAME:My cal") (has *ical* "VERSION:2.0") t))
(check "ical crlf" t (has *ical* (format nil "BEGIN:VCALENDAR~C~C" #\return #\newline)))
(check "ical timed scheduled" t (and (has *ical* "DTSTART:20261022T100000") (has *ical* "DTEND:20261022T110000") (has *ical* "SUMMARY:S: Dentist") t))
(check "ical repeater" t (has *ical* "RRULE:FREQ=WEEKLY;INTERVAL=1"))
(check "ical deadline all day" t (and (has *ical* "DTSTART;VALUE=DATE:20261030") (has *ical* "DTEND;VALUE=DATE:20261031") (has *ical* "SUMMARY:DL: Dentist") t))
(check "ical range" t (and (has *ical* "DTSTART;VALUE=DATE:20261102") (has *ical* "DTEND;VALUE=DATE:20261105") t))
(check "ical plain timestamp" t (has *ical* "DTSTART:20261105T143000"))
(check "ical categories" t (has *ical* "CATEGORIES:health"))
(check "ical events" 4 (let ((count 0) (start 0)) (loop (let ((p (search "BEGIN:VEVENT" *ical* :start2 start))) (if p (setf count (1+ count) start (1+ p)) (return)))) count))
(check "ical todos are optional" nil (has *ical* "BEGIN:VTODO"))
(check "ical todos" t (has (export-icalendar *ical-entries* :now '(2026 10 22 8 0) :include-todo t) "BEGIN:VTODO"))

(check "subtree document" '("#+TITLE: Chapter" "#+AUTHOR: Me" "intro" "* Section" "** Deeper")
       (subtree-export-lines '("* Chapter" ":PROPERTIES:" ":EXPORT_AUTHOR: Me" ":EXPORT_FILE_NAME: out.html" ":END:" "intro" "** Section" "*** Deeper") *ek*))
(check "subtree title property" "#+TITLE: Custom" (first (subtree-export-lines '("* Chapter" ":PROPERTIES:" ":EXPORT_TITLE: Custom" ":END:" "x") *ek*)))
