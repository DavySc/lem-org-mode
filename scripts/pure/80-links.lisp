;;; Links and footnotes

(defun lk (line) (mapcar (lambda (l) (list (getf l :kind) (getf l :target) (getf l :description) (getf l :start) (getf l :end))) (links-in-line line)))
(check "bracket link" '((:bracket "http://x" nil 4 16)) (lk "see [[http://x]] now"))
(check "bracket link with description" '((:bracket "file:a.org" "A" 0 17)) (lk "[[file:a.org][A]] text"))
(check "plain url" '((:plain "https://example.com/a?b=1" nil 6 31)) (lk "visit https://example.com/a?b=1, ok"))
(check "angle link" '((:angle "https://x.org" nil 2 17)) (lk "a <https://x.org> b"))
(check "two links" '(:bracket :plain) (mapcar #'first (lk "[[a]] and mailto:me@x.org")))
(check "no link in plain brackets" nil (lk "a [b] c [d]"))
(check "word with colon is not a url" nil (lk "note: this is fine"))
(check "link at column" "b" (getf (link-at-column "[[a]] [[b]]" 8) :target))
(check "no link at column" nil (link-at-column "[[a]] x [[b]]" 6))
(check "format link" '("[[a][b]]" "[[a]]" "[[a]]") (list (link-format "a" "b") (link-format "a") (link-format "a" "")))

(defun cls (target) (multiple-value-list (link-classify target)))
(check "classify url" '(:url "https://x.org" nil) (cls "https://x.org"))
(check "classify mailto" '(:url "mailto:a@b.c" nil) (cls "mailto:a@b.c"))
(check "classify file" '(:file "a.org" nil) (cls "file:a.org"))
(check "classify file with search" '(:file "a.org" "*Intro") (cls "file:a.org::*Intro"))
(check "classify path" '(:file "~/notes.org" nil) (cls "~/notes.org"))
(check "classify relative path" '(:file "./x.txt" "12") (cls "./x.txt::12"))
(check "classify id" '(:id "abc" nil) (cls "id:abc"))
(check "classify shell" '(:shell "ls -l" nil) (cls "shell:ls -l"))
(check "classify heading" '(:heading "Intro" nil) (cls "*Intro"))
(check "classify custom id" '(:custom-id "sec1" nil) (cls "#sec1"))
(check "classify coderef" '(:coderef "ref" nil) (cls "(ref)"))
(check "classify fuzzy" '(:fuzzy "some target" nil) (cls "some target"))
(check "search kinds" '((:line 12) (:heading "A") (:custom-id "x") (:regexp "a.b") (:text "foo") nil)
       (mapcar #'link-search-kind '("12" "*A" "#x" "/a.b/" "foo" nil)))
(check "abbreviation %s" "https://github.com/foo/bar" (link-expand-abbreviation "gh:foo/bar" '(("gh" . "https://github.com/%s"))))
(check "abbreviation %h encodes" "https://g.com/q?a%20b" (link-expand-abbreviation "g:a b" '(("g" . "https://g.com/q?%h"))))
(check "abbreviation appends" "http://x/tag" (link-expand-abbreviation "x:tag" '(("x" . "http://x/"))))
(check "unknown abbreviation is unchanged" "zz:foo" (link-expand-abbreviation "zz:foo" '(("gh" . "u"))))
(check "link abbreviations from lines" '(("gh" . "https://github.com/%s")) (link-abbreviations-from-lines '("#+LINK: gh https://github.com/%s" "#+TITLE: x")))

(defvar *lk-lines* '("#+TITLE: t" "* TODO [#A] Intro [1/2] :tag:" ":PROPERTIES:" ":CUSTOM_ID: intro" ":ID: 123" ":END:" "Some <<anchor>> text" "" "#+NAME: tbl" "| a |" "* Second   Heading" "see <<<radio>>>" "last line"))
(defvar *lk-kw* '("TODO" "DONE"))
(check "heading link text" "Intro" (heading-link-text (second *lk-lines*) *lk-kw*))
(check "find heading exact" 1 (lines-find-heading *lk-lines* "Intro" *lk-kw*))
(check "find heading ignores space differences" 10 (lines-find-heading *lk-lines* "second heading" *lk-kw*))
(check "find heading by prefix" 10 (lines-find-heading *lk-lines* "Sec" *lk-kw*))
(check "find custom id" 1 (lines-find-search *lk-lines* "#intro" *lk-kw*))
(check "find line number" 6 (lines-find-search *lk-lines* "7" *lk-kw*))
(check "find regexp" 11 (lines-find-search *lk-lines* "/radio/" *lk-kw*))
(check "find dedicated target" 6 (lines-find-search *lk-lines* "anchor" *lk-kw*))
(check "find radio target" 11 (lines-find-dedicated-target *lk-lines* "radio"))
(check "find name" 8 (lines-find-search *lk-lines* "tbl" *lk-kw*))
(check "find text" 12 (lines-find-search *lk-lines* "last" *lk-kw*))
(check "find property" 1 (lines-find-property *lk-lines* "ID" "123" *lk-kw*))
(check "no match" nil (lines-find-search *lk-lines* "zzz" *lk-kw*))
(check "uuid shape" t (let ((u (make-uuid))) (and (= 36 (length u)) (char= (char u 8) #\-) (char= (char u 14) #\4))))
(check "file link" '("file:/a/b.org::*Intro" "file:/a/b.org") (list (make-file-link "/a/b.org" "Intro") (make-file-link "/a/b.org" nil)))

(check "footnote refs" '((0 6 "1" nil) (9 19 "n" "def") (22 30 "" "in"))
       (footnote-references "[fn:1] x [fn:n:def] y [fn::in]"))
(check "footnote refs with nested brackets" '((0 19 "a" "see [[x]] ok"))
       (footnote-references "[fn:a:see [[x]] ok]"))
(check "footnote definition" "1" (footnote-definition-label "[fn:1] The text"))
(check "not a definition" nil (footnote-definition-label "text [fn:1]"))
(check "next footnote number" 3 (footnote-next-number '("a [fn:1]" "[fn:1] def" "b [fn:2]")))
(check "next footnote number skips named" 1 (footnote-next-number '("a [fn:x]")))
(check "definition index" 2 (footnote-definition-index '("a [fn:1]" "" "[fn:1] def") "1"))
(check "reference index" 0 (footnote-reference-index '("a [fn:1]" "" "[fn:1] def") "1"))
