;;; Timestamps

(defun ts (text) (timestamp-parse text))
(check "parse plain" '(:active t :year 2026 :month 10 :day 22 :hour nil :minute nil :end-hour nil :end-minute nil :repeater nil :warning nil)
       (ts "<2026-10-22 Thu>"))
(check "parse inactive with time" '(nil 14 30)
       (let ((x (ts "[2026-10-22 Thu 14:30]"))) (list (getf x :active) (getf x :hour) (getf x :minute))))
(check "parse time range" '(9 0 10 30) (let ((x (ts "<2026-10-22 Thu 09:00-10:30>"))) (list (getf x :hour) (getf x :minute) (getf x :end-hour) (getf x :end-minute))))
(check "parse repeater and warning" '((:cumulate 1 :w) (:all 3 :d))
       (let ((x (ts "<2026-10-22 Thu +1w -3d>"))) (list (getf x :repeater) (getf x :warning))))
(check "parse ++ and .+" '((:catch-up 2 :d) (:restart 1 :m))
       (list (getf (ts "<2026-10-22 ++2d>") :repeater) (getf (ts "<2026-10-22 .+1m>") :repeater)))
(check "parse end position" 16 (nth-value 1 (ts "<2026-10-22 Thu> trailing")))
(check "parse rejects text" nil (ts "<hello world>"))
(check "format" "<2026-10-22 Thu 14:30 +1w -3d>" (timestamp-format (ts "<2026-10-22 Thu 14:30 +1w -3d>")))
(check "format fixes the day name" "[2026-10-22 Thu]" (timestamp-format (ts "[2026-10-22 Mon]")))
(check "format range" "<2026-10-22 Thu 09:00-10:30>" (timestamp-format (ts "<2026-10-22 09:00-10:30>")))
(check "timestamps in text" '("<2026-10-22 Thu>" "[2026-10-23 Fri 10:00]")
       (mapcar (lambda (x) (timestamp-format (first x))) (timestamps-in-text "see <2026-10-22 Thu> and [2026-10-23 Fri 10:00] [x]")))
(check "weekday" '(3 "Thu") (list (day-weekday (date-day 2026 10 22)) (day-name (date-day 2026 10 22))))
(check "days in month" '(29 28 31 30) (list (days-in-month 2028 2) (days-in-month 2026 2) (days-in-month 2026 12) (days-in-month 2026 4)))
(check "shift month clamps" '(2027 2 28) (multiple-value-list (date-shift 2026 12 31 2 :m)))
(check "shift year" '(2027 2 28) (multiple-value-list (date-shift 2026 2 28 1 :y)))
(check "shift week" '(2026 11 5) (multiple-value-list (date-shift 2026 10 29 1 :w)))
(check "add hours carries" "<2026-10-23 Fri 01:30>" (timestamp-format (timestamp-add (ts "<2026-10-22 Thu 23:30>") 2 :h)))
(defvar *d* (date-day 2026 10 22))
(check "+ repeat adds once" "<2026-10-29 Thu +1w>" (timestamp-format (timestamp-next-repeat (ts "<2026-10-22 Thu +1w>") (+ *d* 30))))
(check "++ repeat lands in the future" "<2026-12-03 Thu ++1w>" (timestamp-format (timestamp-next-repeat (ts "<2026-10-22 Thu ++1w>") (date-day 2026 11 30))))
(check ".+ repeat counts from today" "<2026-12-02 Wed .+2d>" (timestamp-format (timestamp-next-repeat (ts "<2026-10-22 Thu .+2d>") (date-day 2026 11 30))))
(check "++ repeat today with time later keeps today" "<2026-11-30 Mon 18:00 ++1d>"
       (timestamp-format (timestamp-next-repeat (ts "<2026-11-29 Sun 18:00 ++1d>") (date-day 2026 11 30) (* 9 60))))
(check "occurrences of a plain date" (list *d*) (timestamp-occurrences (ts "<2026-10-22 Thu>") (- *d* 3) (+ *d* 3)))
(check "occurrences outside" nil (timestamp-occurrences (ts "<2026-10-22 Thu>") (+ *d* 1) (+ *d* 3)))
(check "occurrences repeating" (list (+ *d* 7) (+ *d* 14)) (timestamp-occurrences (ts "<2026-10-22 Thu +1w>") (+ *d* 5) (+ *d* 20)))
(check "occurrences monthly" (list (date-day 2026 12 22)) (timestamp-occurrences (ts "<2026-10-22 Thu +2m>") (date-day 2026 12 1) (date-day 2026 12 31)))

;;; typed dates
(defun din (text &optional time) (multiple-value-list (date-input-parse text *d* time)))
(check "input empty" (list *d* nil nil nil nil) (din ""))
(check "input tomorrow" (list (1+ *d*) nil nil nil nil) (din "tomorrow"))
(check "input +3d" (list (+ *d* 3) nil nil nil nil) (din "+3d"))
(check "input -2w" (list (- *d* 14) nil nil nil nil) (din "-2w"))
(check "input +1m" (list (date-day 2026 11 22) nil nil nil nil) (din "+1m"))
(check "input ++1w" (list (+ *d* 7) nil nil nil nil) (din "++1w"))
(check "input weekday is the next one" (list (+ *d* 1) nil nil nil nil) (din "fri"))
(check "input same weekday means next week" (list (+ *d* 7) nil nil nil nil) (din "thu"))
(check "input iso" (list (date-day 2027 1 3) nil nil nil nil) (din "2027-01-03"))
(check "input iso with time" (list (date-day 2027 1 3) 14 30 nil nil) (din "2027-01-03 14:30"))
(check "input month-day this year or next" (list (date-day 2026 12 24) nil nil nil nil) (din "12-24"))
(check "input month-day already past rolls over" (list (date-day 2027 3 5) nil nil nil nil) (din "3/5"))
(check "input day only" (list (date-day 2026 11 3) nil nil nil nil) (din "3"))
(check "input day later this month" (list (date-day 2026 10 28) nil nil nil nil) (din "28"))
(check "input month name" (list (date-day 2027 2 3) nil nil nil nil) (din "feb 3"))
(check "input month name reversed with year" (list (date-day 2028 2 3) nil nil nil nil) (din "3 February 2028"))
(check "input time only" (list *d* 9 5 nil nil) (din "9:05"))
(check "input am pm" (list (+ *d* 1) 15 0 nil nil) (din "tomorrow 3pm"))
(check "input time range" (list *d* 9 0 10 30) (din "9:00-10:30"))
(check "input default time" (list *d* 8 0 nil nil) (din "" '(8 0)))
(check-error "input garbage" (date-input-parse "blorp" *d*))
(check-error "input bad month day" (date-input-parse "2026-02-30" *d*))
