;;; Export: options, preprocessing, inline markup, structure

(defvar *ek* '("TODO" "DONE"))
(defun html-of (&rest lines) (export-html lines *ek* :body-only t))
(defun full-html (&rest lines) (export-html lines *ek*))
(defun md-of (&rest lines) (export-markdown lines *ek*))
(defun has (text part) (and (search part text) t))

(check "options parse" '(:toc 2 :num nil :levels 4 :sub-super :brace :tags nil)
       (options-parse "toc:2 num:nil H:4 ^:{} tags:nil"))
(check "options default" '(t t 3) (let ((o (export-options nil))) (list (getf o :toc) (getf o :num) (getf o :levels))))
(check "options from meta" '(nil nil) (let ((o (export-options '(("OPTIONS" . "toc:nil num:nil"))))) (list (getf o :toc) (getf o :num))))
(check "options last wins" 5 (getf (export-options '(("OPTIONS" . "H:2") ("OPTIONS" . "H:5"))) :levels))

;;; includes, macros, filters
(defun reader (name) (cdr (assoc name '(("inc.org" . ("* Included" "text")) ("code.py" . ("print(1)" "* star"))
                                         ("setup.org" . ("#+OPTIONS: toc:nil")) ("lines.txt" . ("a" "b" "c" "d" "e")))
                                  :test #'string=)))
(check "include org file" '("before" "* Included" "text" "after") (export-expand-includes '("before" "#+INCLUDE: \"inc.org\"" "after") *ek* #'reader))
(check "include with minlevel" '("*** Included" "text") (export-expand-includes '("#+INCLUDE: \"inc.org\" :minlevel 3") *ek* #'reader))
(check "include as src block escapes stars" '("#+begin_src python" "print(1)" ",* star" "#+end_src")
       (export-expand-includes '("#+INCLUDE: \"code.py\" src python") *ek* #'reader))
(check "include lines range" '("b" "c") (export-expand-includes '("#+INCLUDE: \"lines.txt\" :lines \"2-4\"") *ek* #'reader))
(check "include missing file" '("# Cannot include nope.org") (export-expand-includes '("#+INCLUDE: \"nope.org\"") *ek* #'reader))
(check "setupfile" '("#+OPTIONS: toc:nil" "x") (export-expand-setupfiles '("#+SETUPFILE: setup.org" "x") #'reader))
(check "macro definitions" '(("hi" . "Hello $1")) (macro-definitions '("#+MACRO: hi Hello $1" "text")))
(check "macro arguments" '("a" "b,c" "d") (macro-split-arguments "a, b\\,c, d"))
(check "macro expansion" "say Hello Bob!" (macro-expand-line "say {{{hi(Bob)}}}!" '(("hi" . "Hello $1")) (lambda (n a) (declare (ignore n a)) nil)))
(check "builtin macro" "by Me" (macro-expand-line "by {{{author}}}" nil (lambda (n a) (declare (ignore a)) (and (string= n "author") "Me"))))
(check "unknown macro stays" "{{{zz}}}" (macro-expand-line "{{{zz}}}" nil (lambda (n a) (declare (ignore n a)) nil)))
(check "macros are not expanded in src blocks" '("#+begin_src sh" "{{{x}}}" "#+end_src" "A")
       (export-expand-macros '("#+begin_src sh" "{{{x}}}" "#+end_src" "{{{x}}}") '(("x" . "A")) (lambda (n a) (declare (ignore n a)) nil)))
(check "filter noexport" '("* Keep" "* Other") (export-filter-subtrees '("* Keep" "* Drop :noexport:" "text" "** child" "* Other") *ek*))
(check "filter comment heading" '("* Keep") (export-filter-subtrees '("* Keep" "* COMMENT Drop" "text") *ek*))
(check "filter select tags" '("* Parent" "** Chosen :export:" "body") (export-filter-subtrees '("* Parent" "text" "** Chosen :export:" "body" "** Not chosen" "x") *ek* :select '("export")))
(check "filter archived keeps heading" '("* Old :ARCHIVE:") (export-filter-subtrees '("* Old :ARCHIVE:" "secret") *ek*))

;;; structure
(check "no toc without headings" nil (has (html-of "text") "id=\"table-of-contents\""))
(check "heading numbers and ids" t
       (let ((html (full-html "* One" "** Sub" "* Two")))
         (and (has html "section-number-2\">1</span>") (has html "section-number-3\">1.1</span>") (has html "section-number-2\">2</span>")
              (has html "outline-container-") (has html "class=\"outline-3\"") t)))
(check "toc entries" t
       (let ((html (full-html "* One" "** Sub" "* Two")))
         (and (has html "id=\"table-of-contents\"") (has html ">1. One</a>") (has html ">1.1. Sub</a>") (has html ">2. Two</a>") t)))
(check "toc:nil" nil (has (full-html "#+OPTIONS: toc:nil" "* One") "id=\"table-of-contents\""))
(check "toc depth" nil (has (full-html "#+OPTIONS: toc:1" "* One" "** Sub") ">1.1. Sub</a>"))
(check "num:nil" nil (has (full-html "#+OPTIONS: num:nil" "* One") "section-number"))
(check "unnumbered property" nil (has (full-html "* One" ":PROPERTIES:" ":UNNUMBERED: t" ":END:") "section-number"))
(check "custom id is the html id" t (has (full-html "* One" ":PROPERTIES:" ":CUSTOM_ID: intro" ":END:") "id=\"intro\""))
(check "deep headings become list items" t (let ((html (html-of "* A" "** B" "*** C" "**** D"))) (and (has html "<ul class=\"org-ul\">") (not (has html "<h5")) t)))
(check "H:4 keeps a fourth level" t (has (html-of "#+OPTIONS: H:4" "* A" "** B" "*** C" "**** D") "<h5"))
(check "tags off" nil (has (html-of "#+OPTIONS: tags:nil" "* A :x:") "class=\"tag\""))
(check "todo off" nil (has (html-of "#+OPTIONS: todo:nil" "* TODO A") "class=\"todo"))
(check "toc placement with #+TOC" t (let ((html (full-html "#+TOC: headlines 1" "* One" "** Sub"))) (and (has html "id=\"table-of-contents\"") (not (has html ">1.1. Sub</a>")) t)))
(check "title and author in the head" t (let ((html (full-html "#+TITLE: T" "#+AUTHOR: Me" "#+LANGUAGE: nl" "x"))) (and (has html "<title>T</title>") (has html "<meta name=\"author\" content=\"Me\">") (has html "lang=\"nl\"") t)))
(check "html head lines" t (has (full-html "#+HTML_HEAD: <link rel=\"stylesheet\" href=\"a.css\">" "x") "href=\"a.css\""))
(check "exclude tags in text" nil (has (html-of "* Keep" "* Drop :noexport:" "secret") "secret"))
(check "macros in html" t (has (html-of "#+MACRO: hi Hello $1" "{{{hi(World)}}}") "Hello World"))
(check "title macro" t (has (html-of "#+TITLE: My Doc" "see {{{title}}}") "see My Doc"))

;;; inline
(defun inl (text) (export-inline text :html))
(check "footnote text" t
       (let ((html (html-of "A claim.[fn:1]" "" "[fn:1] The source.")))
         (and (has html "class=\"footref\"") (has html "id=\"footnotes\"") (has html "The source.") (has html "href=\"#fn.1\"") t)))
(check "inline footnote definition" t (let ((html (html-of "Text[fn::inline note]."))) (and (has html "inline note") (has html "class=\"footnum\"") t)))
(check "footnotes numbered by appearance" t (let ((html (html-of "A[fn:b] B[fn:a]." "" "[fn:a] first" "[fn:b] second"))) (and (< (search "second" html) (search "first" html)) t)))
(check "footnotes off" nil (has (html-of "#+OPTIONS: f:nil" "A[fn:1]" "" "[fn:1] x") "class=\"footref\""))
(check "entities" "α → ©" (let ((s (export-inline "\\alpha \\to \\copy" :markdown))) s))
(check "html entities" "&alpha; &rarr;" (inl "\\alpha \\to"))
(check "unknown entity is text" "\\zzz" (inl "\\zzz"))
(check "subscript with braces" "H<sub>2</sub>O" (inl "H_{2}O"))
(check "superscript with braces" "x<sup>2</sup>" (inl "x^{2}"))
(check "plain underscores are left alone" "snake_case_name" (inl "snake_case_name"))
(check "special strings" "a&ndash;b&mdash;c&hellip;" (inl "a--b---c..."))
(check "line break" (format nil "a<br>~%b") (inl (format nil "a\\\\~%b")))
(check "timestamp" "<span class=\"timestamp-wrapper\"><span class=\"timestamp\">&lt;2026-10-22 Thu&gt;</span></span>" (inl "<2026-10-22 Thu>"))
(check "inactive timestamp" t (has (inl "[2026-10-22 Thu 10:00]") "timestamp"))
(check "cookie text stays" "[1/2]" (inl "[1/2]"))
(check "math inline" "\\(x^2\\)" (inl "$x^2$"))
(check "dollar amounts are not math" "costs $5 or $6" (inl "costs $5 or $6"))
(check "math display" "\\[a+b\\]" (inl "\\[a+b\\]"))
(check "export snippet" "<b>x</b>" (inl "@@html:<b>x</b>@@"))
(check "export snippet for another backend" "" (inl "@@latex:\\x@@"))
(check "inline source code" "<code class=\"src src-python\">1+1</code>" (inl "src_python{1+1}"))
(check "plain url becomes a link" "<a href=\"https://x.org/a\">https://x.org/a</a>" (inl "https://x.org/a"))
(check "plain url keeps trailing punctuation outside" "see <a href=\"https://x.org\">https://x.org</a>." (inl "see https://x.org."))
(check "link to a file with description" "<a href=\"b.html\">B</a>" (inl "[[file:b.org][B]]"))
(check "link to a pdf" "<a href=\"b.pdf\">B</a>" (inl "[[file:b.pdf][B]]"))
(check "image with description link" "<a href=\"https://x\"><img src=\"p.png\" alt=\"p.png\"></a>" (inl "[[https://x][file:p.png]]"))
(check "internal heading link resolves" t (has (html-of "* Target" "see [[*Target]]") "href=\"#org"))
(check "custom id link resolves" "see <a href=\"#intro\">there</a>" (let ((html (html-of "* H" ":PROPERTIES:" ":CUSTOM_ID: intro" ":END:" "see [[#intro][there]]"))) (subseq html (search "see " html) (+ 4 (search "</a>" html)))))
(check "dedicated target" t (let ((html (html-of "A <<here>> mark." "go [[here]]"))) (and (has html "id=\"org-target--here\"") (has html "href=\"#org-target--here\"") t)))
(check "unresolved internal link keeps text" "see Nowhere" (inl "see [[*Nowhere]]"))
(check "link abbreviation" "<a href=\"https://github.com/a/b\">x</a>" (let ((*org-link-abbrev-alist* '(("gh" . "https://github.com/%s")))) (inl "[[gh:a/b][x]]")))
(check "bold in link description" "<a href=\"http://x\"><b>y</b></a>" (inl "[[http://x][*y*]]"))
(check "verbatim is not interpreted" "<code>*a*</code>" (inl "=*a*="))
(check "emphasis not inside words" "a*b*c" (inl "a*b*c"))
(check "escaping" "&lt;a&gt; &amp; &quot;q&quot;" (inl "<a> & \"q\""))

;;; blocks
(check "table caption and name" t (let ((html (html-of "#+CAPTION: Sales" "#+NAME: sales" "| a | b |"))) (and (has html "<caption class=\"t-above\"><span class=\"table-number\">Table 1:</span> Sales</caption>") (has html "id=\"sales\"") t)))
(check "src caption" t (has (html-of "#+CAPTION: Hello" "#+begin_src sh" "echo" "#+end_src") "Listing 1: </span>Hello"))
(check "figure with caption" t (let ((html (html-of "#+CAPTION: A cat" "#+ATTR_HTML: :width 300 :alt cat" "[[file:cat.png]]"))) (and (has html "<div class=\"figure\">") (has html "width=\"300\"") (has html "alt=\"cat\"") (has html "Figure 1: </span>A cat") t)))
(check "description list" t (let ((html (html-of "- term :: meaning" "- other :: thing"))) (and (has html "<dl class=\"org-dl\">") (has html "<dt>term</dt><dd>meaning</dd>") t)))
(check "verse" t (has (html-of "#+begin_verse" "line one" "line two" "#+end_verse") "line one<br>"))
(check "center" t (has (html-of "#+begin_center" "mid" "#+end_center") "org-center"))
(check "special block" t (has (html-of "#+begin_note" "careful" "#+end_note") "<div class=\"note\">"))
(check "raw html line" t (has (html-of "#+HTML: <hr class=\"x\">") "<hr class=\"x\">"))
(check "export block html" t (has (html-of "#+begin_export html" "<i>raw</i>" "#+end_export") "<i>raw</i>"))
(check "export block for another backend is dropped" nil (has (html-of "#+begin_export latex" "\\raw" "#+end_export") "raw"))
(check "comment block dropped" nil (has (html-of "#+begin_comment" "hidden" "#+end_comment") "hidden"))
(check "planning shown with p:t" t (has (html-of "#+OPTIONS: p:t" "* A" "DEADLINE: <2026-10-25 Sun>") "DEADLINE"))
(check "planning hidden by default" nil (has (html-of "* A" "DEADLINE: <2026-10-25 Sun>") "DEADLINE"))
(check "src block has a language class" t (has (html-of "#+begin_src emacs-lisp" "(+ 1 2)" "#+end_src") "src-emacs-lisp"))
(check "example block keeps text" t (has (html-of "#+begin_example" "  indented" "#+end_example") "  indented"))
(check "comma escapes are removed in src" t (has (html-of "#+begin_src org" ",* not a heading" "#+end_src") ">* not a heading"))
(check "mathjax is added for math" t (has (full-html "$x$") "mathjax"))
(check "no mathjax without math" nil (has (full-html "plain") "mathjax"))

;;; markdown
(check "markdown footnotes" t (let ((md (md-of "A[fn:1]" "" "[fn:1] note"))) (and (has md "A[^1]") (has md "[^1]: note") t)))
(check "markdown entities are characters" "α" (export-inline "\\alpha" :markdown))
(check "markdown subscript" "H<sub>2</sub>" (export-inline "H_{2}" :markdown))
(check "markdown link to org file" "[B](b.md)" (export-inline "[[file:b.org][B]]" :markdown))
(check "markdown image" "![p.png](p.png)" (export-inline "[[file:p.png]]" :markdown))
(check "markdown description list" t (has (md-of "- term :: meaning") "**term** meaning"))
