;;; Capture and refile

(defvar *ck* '("TODO" "DONE"))
(defvar *ctime* '(2026 10 22 14 5 9))
(defun expand (template &rest context)
  (multiple-value-list (capture-expand template (append context (list :time *ctime*)))))

(check "time spec" "2026-10-22 Thursday 14:05 Oct" (format-time-spec "%Y-%m-%d %A %H:%M %b" *ctime*))
(check "time spec iso" "2026-10-22 14:05:09" (format-time-spec "%F %T" *ctime*))
(check "time spec day of year" "295" (format-time-spec "%j" *ctime*))
(check "expand plain" '("hello" nil nil) (expand "hello"))
(check "expand active date" '("* TODO <2026-10-22 Thu>" nil nil) (expand "* TODO %t"))
(check "expand date time" '("<2026-10-22 Thu 14:05> [2026-10-22 Thu] [2026-10-22 Thu 14:05]" nil nil) (expand "%T %u %U"))
(check "expand cursor" '("* TODO " 7 nil) (expand "* TODO %?"))
(check "expand cursor in the middle" '("a b" 2 nil) (expand "a %?b"))
(check "expand format" '("14:05 on 22" nil nil) (expand "%<%H:%M> on %<%d>"))
(check "expand initial and annotation" '("see [[file:a.org]]: text" nil nil) (expand "see %a: %i" :annotation "[[file:a.org]]" :initial "text"))
(check "expand file info" '("a.org /tmp/a.org bob" nil nil) (expand "%f %F %n" :file "a.org" :path "/tmp/a.org" :user "bob"))
(check "expand percent" '("100%" nil nil) (expand "100%%"))
(check "expand unknown stays" '("%z" nil nil) (expand "%z"))
(check "multi-line initial keeps its column" (list (format nil "  x: one~%     two") nil nil) (expand (format nil "  x: %i") :initial (format nil "one~%two")))
(check "prompts" '("Title: Hi / Hi" nil nil)
       (expand "Title: %^{Title|Hello} / %\\1" :prompt (lambda (kind prompt default options) (declare (ignore kind prompt default options)) "Hi")))
(check "prompt gets default and options" '("x" nil nil)
       (let (seen) (expand "%^{Pick|b|a|b|c}" :prompt (lambda (kind p d o) (setf seen (list kind p d o)) "x"))
         (list "x" nil (if (equal seen '(:string "Pick" "b" ("a" "b" "c"))) nil seen))))
(check "date prompt" '("<2026-12-24 Thu>" nil nil)
       (expand "%^t" :prompt (lambda (kind p d o) (declare (ignore p d o)) (if (eq kind :date) "<2026-12-24 Thu>" ""))))
(check "tags prompt" '("* x " nil ("a" "b"))
       (expand "* x %^g" :prompt (lambda (kind p d o) (declare (ignore p d o)) (if (eq kind :tags) "a:b" ""))))

(check "datetree titles" '("2026" "2026-10 October" "2026-10-22 Thursday") (datetree-titles 2026 10 22))
(defun cap (lines target type text &rest keys)
  (multiple-value-list (apply #'capture-insert lines target type text *ck* keys)))
(check "capture to file end" '(("* A" "* TODO new") 1) (cap '("* A") nil 'entry "* TODO new"))
(check "capture to file prepend" '(("* TODO new" "* A") 0) (cap '("* A") nil 'entry "* TODO new" :prepend t))
(check "capture prepend skips file header" '(("#+TITLE: t" "* TODO new" "* A") 1) (cap '("#+TITLE: t" "* A") nil 'entry "* TODO new" :prepend t))
(check "capture under headline, level adapts" '(("* Tasks" "** TODO x" "* Other") 1)
       (cap '("* Tasks" "* Other") '(:olp ("Tasks")) 'entry "* TODO x"))
(check "capture under headline appends after the last child" '(("* Tasks" "** a" "body" "** TODO x" "* Other") 3)
       (cap '("* Tasks" "** a" "body" "* Other") '(:olp ("Tasks")) 'entry "* TODO x"))
(check "capture under headline prepend goes after planning and drawer" '(("* Tasks" "SCHEDULED: <2026-10-22 Thu>" "** TODO x" "** a") 2)
       (cap '("* Tasks" "SCHEDULED: <2026-10-22 Thu>" "** a") '(:olp ("Tasks")) 'entry "* TODO x" :prepend t))
(check "capture creates the headline" '(("* A" "* Tasks" "** TODO x") 2) (cap '("* A") '(:olp ("Tasks")) 'entry "* TODO x"))
(check "capture creates a nested path" '(("* A" "** B" "*** x") 2) (cap '("* A") '(:olp ("A" "B")) 'entry "* x"))
(check "capture with empty lines" '(("* A" "" "* x" "") 2) (cap '("* A") nil 'entry "* x" :empty-lines 1))
(check "capture multi-line entry keeps sub-levels" '(("* P" "** x" "*** sub" "text") 1)
       (cap '("* P") '(:olp ("P")) 'entry (format nil "* x~%** sub~%text")))
(check "capture to datetree creates the tree" '(("* 2026" "** 2026-10 October" "*** 2026-10-22 Thursday" "**** 14:05 note") 3)
       (cap nil '(:datetree t) 'entry "* 14:05 note" :date '(2026 10 22)))
(check "capture to datetree reuses the day" '(("* 2026" "** 2026-10 October" "*** 2026-10-22 Thursday" "**** one" "**** two") 4)
       (cap '("* 2026" "** 2026-10 October" "*** 2026-10-22 Thursday" "**** one") '(:datetree t) 'entry "* two" :date '(2026 10 22)))
(check "capture to datetree keeps days sorted" '(("* 2026" "** 2026-10 October" "*** 2026-10-21 Wednesday" "*** 2026-10-22 Thursday" "**** x" "*** 2026-10-23 Friday") 4)
       (cap '("* 2026" "** 2026-10 October" "*** 2026-10-21 Wednesday" "*** 2026-10-23 Friday") '(:datetree t) 'entry "* x" :date '(2026 10 22)))
(check "capture to datetree under a heading" '(("* Journal" "** 2026" "*** 2026-10 October" "**** 2026-10-22 Thursday" "***** x") 4)
       (cap '("* Journal") '(:datetree t :olp ("Journal")) 'entry "* x" :date '(2026 10 22)))
(check "capture item appends to the list" '(("* L" "- a" "- b" "- new" "* M") 3) (cap '("* L" "- a" "- b" "* M") '(:olp ("L")) 'item "- new"))
(check "capture item prepend" '(("* L" "- new" "- a") 1) (cap '("* L" "- a") '(:olp ("L")) 'item "- new" :prepend t))
(check "capture item without a list" '(("* L" "text" "- new") 2) (cap '("* L" "text") '(:olp ("L")) 'item "- new"))
(check "capture table line" '(("* T" "| a | 1 |" "| b | 2 |") 2) (cap '("* T" "| a | 1 |") '(:olp ("T")) 'table-line "| b | 2 |"))
(check "capture plain text" '(("* A" "note") 1) (cap '("* A") '(:olp ("A")) 'plain "note"))
(check "capture after regexp" '(("a" "b" "* x" "c") 2) (cap '("a" "b" "c") '(:regexp "b") 'entry "* x"))
(check-error "regexp that matches nothing" (cap '("a") '(:regexp "zzz") 'entry "* x"))

(defvar *rl* '("* A" "** A1" "body" "* B" "** B1"))
(check "remove subtree" '(("* A" "** A1" "body") ("* B" "** B1")) (multiple-value-list (lines-remove-subtree *rl* 3 *ck*)))
(check "put subtree last under a heading" '(("* A" "** A1" "body" "** moved" "*** sub" "* B" "** B1") 3)
       (multiple-value-list (lines-put-subtree *rl* 0 '("* moved" "** sub") *ck*)))
(check "put subtree first under a heading" '(("* A" "** moved" "** A1" "body" "* B" "** B1") 1)
       (multiple-value-list (lines-put-subtree *rl* 0 '("* moved") *ck* :prepend t)))
(check "put subtree at top level" '(("* A" "** A1" "body" "* B" "** B1" "* moved") 5)
       (multiple-value-list (lines-put-subtree *rl* nil '("** moved") *ck*)))
(check "refile targets" '("A" "B") (mapcar #'car (refile-targets (agenda-parse *rl* *ck* "x.org") '(:maxlevel 1))))
(check "refile targets deeper" '("A" "A/A1" "B" "B/B1") (mapcar #'car (refile-targets (agenda-parse *rl* *ck* "x.org") '(:maxlevel 2))))
(check "refile targets by tag" '("B") (mapcar #'car (refile-targets (agenda-parse (list "* A" "* B :t:") *ck* "x.org") '(:maxlevel 1 :tag "t"))))
