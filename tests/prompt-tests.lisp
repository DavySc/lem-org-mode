;;; Commands that ask questions, driven by canned answers.
(in-package :lem-org-mode/tests)

(defvar *answers* '())

(defmacro with-answers ((&rest answers) &body body)
  "Run BODY with prompt-for-string answering with ANSWERS in order (and prompt-for-y-or-n-p with yes)."
  `(let ((*answers* (list ,@answers)))
     (sb-ext:without-package-locks
       (sb-int:encapsulate 'lem:prompt-for-string 'canned
                           (lambda (function &rest arguments)
                             (declare (ignore function arguments))
                             (if *answers* (pop *answers*) (error "No canned answer left"))))
       (sb-int:encapsulate 'lem:prompt-for-y-or-n-p 'canned (lambda (function &rest arguments) (declare (ignore function arguments)) t)))
     (unwind-protect (progn ,@body)
       (sb-ext:without-package-locks
         (sb-int:unencapsulate 'lem:prompt-for-string 'canned)
         (sb-int:unencapsulate 'lem:prompt-for-y-or-n-p 'canned)))))

(deftest test-prompt-planning-commands
  (let ((buffer (make-org-buffer (lines "* TODO task" "body"))))
    (setf (lem:current-buffer) buffer)
    (move-to-line (current-point) 1)
    (with-answers ("2026-11-03 14:30") (lem-org-mode::org-schedule))
    (ok (search "SCHEDULED: <2026-11-03 Tue 14:30>" (text-of buffer)))
    (with-answers ("+1w") (lem-org-mode::org-deadline))
    (ok (search "DEADLINE: <" (text-of buffer)))
    (with-answers ("work:home") (lem-org-mode::org-set-tags-command))
    (ok (search ":work:home:" (line-string (line-point buffer 1))))
    (with-answers ("Owner" "me") (lem-org-mode::org-set-property-command))
    (ok (search ":Owner: me" (text-of buffer)))
    (with-answers ("A") (lem-org-mode::org-priority))
    (ok (search "[#A]" (line-string (line-point buffer 1))))
    (with-answers ("1:30") (lem-org-mode::org-set-effort-command))
    (ok (search ":Effort: 1:30" (text-of buffer)))
    (with-answers ("remember the milk") (lem-org-mode::org-add-note-command))
    (ok (search "remember the milk" (text-of buffer)))))

(deftest test-prompt-todo-select-with-note
  (let ((buffer (make-org-buffer (lines "#+TODO: TODO(t) WAIT(w@/!) | DONE(d)" "* TODO task"))))
    (setf (lem:current-buffer) buffer)
    (move-to-line (current-point) 2)
    (with-answers ("w" "waiting for Bob") (lem-org-mode::org-todo-select))
    (ok (search "* WAIT task" (text-of buffer)))
    (ok (search "waiting for Bob" (text-of buffer)) "the note was asked for and written")
    (with-answers ("DONE") (lem-org-mode::org-todo-select))
    (ok (search "* DONE task" (text-of buffer)))
    (with-answers ("") (lem-org-mode::org-todo-select))
    (ok (search "* task" (text-of buffer)) "empty answer removes the keyword")
    (ok (signals (with-answers ("nonsense") (lem-org-mode::org-todo-select)) 'editor-error))))

(deftest test-prompt-agenda-dispatcher
  (let ((buffer (make-org-buffer (lines "* TODO write :work:" "SCHEDULED: <2026-10-22 Thu>"))))
    (setf (lem:current-buffer) buffer)
    (let ((lem-org-mode:*org-agenda-custom-commands* '(("n" "Next" tags-todo "work"))))
      (with-answers ("t") (lem-org-mode::org-agenda))
      (ok (search "Global TODO list" (text-of (lem:current-buffer))))
      (setf (lem:current-buffer) buffer)
      (with-answers ("n") (lem-org-mode::org-agenda))
      (ok (search "write" (text-of (lem:current-buffer))))
      (setf (lem:current-buffer) buffer)
      (with-answers ("m" "work") (lem-org-mode::org-agenda))
      (ok (search "TAGS match: work" (text-of (lem:current-buffer))))
      (setf (lem:current-buffer) buffer)
      (with-answers ("s" "write") (lem-org-mode::org-agenda))
      (ok (search "Search words: write" (text-of (lem:current-buffer))))
      (setf (lem:current-buffer) buffer)
      (with-answers ("a") (lem-org-mode::org-agenda))
      (ok (search "Week-agenda" (text-of (lem:current-buffer))))
      (let ((agenda (lem:current-buffer)))
        (with-answers ("+work") (lem-org-mode::org-agenda-filter))
        (ok (search "Week-agenda" (text-of agenda)))
        (with-answers ("-work") (lem-org-mode::org-agenda-filter))
        (lem-org-mode::org-agenda-filter-clear))
      (setf (lem:current-buffer) buffer)
      (ok (signals (with-answers ("zz") (lem-org-mode::org-agenda)) 'editor-error)))))

(deftest test-prompt-capture-flow
  (with-temp-org-file (file (lines "* Tasks"))
    (let ((lem-org-mode:*org-capture-templates*
            `(("t" "Task" entry (file+headline ,(uiop:native-namestring file) "Tasks") "* TODO %^{What} %?")
              ("q" "Quick" entry (file ,(uiop:native-namestring file)) "* %^{Title}" :immediate-finish t)))
          (origin (make-org-buffer "origin")))
      (setf (lem:current-buffer) origin)
      (with-answers ("t" "buy milk")
        (lem-org-mode::org-capture))
      (let ((capture (lem:current-buffer)))
        (ok (search "* TODO buy milk " (text-of capture)))
        (lem-org-mode::org-capture-finalize)
        (ok (search "** TODO buy milk" (text-of (lem:find-file-buffer (uiop:native-namestring file))))))
      (setf (lem:current-buffer) origin)
      (with-answers ("q" "Called Bob")
        (lem-org-mode::org-capture))
      (ok (search "* Called Bob" (text-of (lem:find-file-buffer (uiop:native-namestring file)))) "immediate finish writes at once")
      (setf (lem:current-buffer) origin)
      (with-answers ("t" "discard me")
        (lem-org-mode::org-capture))
      (lem-org-mode::org-capture-kill)
      (ok (not (search "discard me" (text-of (lem:find-file-buffer (uiop:native-namestring file)))))))))

(deftest test-prompt-links-and-refile
  (let ((buffer (make-org-buffer (lines "* Inbox" "** move me" "* Projects" "** Alpha"))))
    (setf (lem:current-buffer) buffer)
    (let ((lem-org-mode:*org-refile-targets* '((:current . (:maxlevel 2)))))
      (move-to-line (current-point) 2)
      (with-answers ("Projects/Alpha") (lem-org-mode::org-refile-command))
      (ok (search (lines "* Projects" "** Alpha" "*** move me") (text-of buffer)))))
  (let ((buffer (make-org-buffer "see ")))
    (setf (lem:current-buffer) buffer)
    (line-end (current-point))
    (with-answers ("https://x.org" "X site") (lem-org-mode::org-insert-link))
    (ok (string= "see [[https://x.org][X site]]" (text-of buffer)))))

(deftest test-prompt-misc-commands
  (let ((buffer (make-org-buffer (lines "b" "a" "c"))))
    (setf (lem:current-buffer) buffer)
    (with-answers ("TIPS") (move-to-line (current-point) 2) (lem-org-mode::org-insert-drawer))
    (ok (search ":TIPS:" (text-of buffer))))
  (let ((buffer (make-org-buffer (lines "#+TITLE: x" "* B" "* A" "* C"))))
    (setf (lem:current-buffer) buffer)
    (move-to-line (current-point) 1)
    (with-answers ("a") (lem-org-mode::org-sort))
    (ok (string= (lines "#+TITLE: x" "* A" "* B" "* C") (text-of buffer)) "before the first heading the top level is sorted"))
  (let ((buffer (make-org-buffer (lines "* TODO a" "needle here" "* b"))))
    (setf (lem:current-buffer) buffer)
    (with-answers ("needle") (lem-org-mode::org-occur))
    (ok (search "L1" (text-of (lem:current-buffer)))))
  (let ((buffer (make-org-buffer "text ")))
    (setf (lem:current-buffer) buffer)
    (line-end (current-point))
    (with-answers ("2026-10-22 9:00") (lem-org-mode::org-time-stamp))
    (ok (search "<2026-10-22 Thu 09:00>" (text-of buffer))))
  (let ((buffer (make-org-buffer (lines "| 1 | 2 |"))))
    (setf (lem:current-buffer) buffer)
    (move-to-line (current-point) 1)
    (setf (point-charpos (current-point)) 6)
    (with-answers ("$2=$1*10") (lem-org-mode::org-table-eval-formula))
    (ok (search "| 1 | 10 |" (text-of buffer)))))

(deftest test-prompt-agenda-entry-commands
  (let ((buffer (make-org-buffer (lines "* TODO first" "* TODO second"))))
    (setf (lem:current-buffer) buffer)
    (with-answers ("t") (lem-org-mode::org-agenda))
    (let ((agenda (lem:current-buffer)))
      (move-to-line (current-point) 3)
      (lem-org-mode::org-agenda-todo)
      (ok (search "* DONE second" (text-of buffer)) "t in the agenda changes the state in the file's buffer")
      (setf (lem:current-buffer) agenda)
      (move-to-line (current-point) 2)
      (with-answers ("2026-12-24") (lem-org-mode::org-agenda-schedule))
      (ok (search "SCHEDULED: <2026-12-24 Thu>" (text-of buffer)))
      (setf (lem:current-buffer) agenda)
      (move-to-line (current-point) 2)
      (with-answers ("urgent") (lem-org-mode::org-agenda-set-tags))
      (ok (search ":urgent:" (text-of buffer)))
      (setf (lem:current-buffer) agenda)
      (move-to-line (current-point) 2)
      (lem-org-mode::org-agenda-priority-up)
      (ok (search "[#C]" (text-of buffer)))
      (setf (lem:current-buffer) agenda)
      (move-to-line (current-point) 2)
      (lem-org-mode::org-agenda-clock-in)
      (ok (search "CLOCK: [" (text-of buffer)))
      (setf (lem:current-buffer) agenda)
      (move-to-line (current-point) 2)
      (lem-org-mode::org-agenda-clock-out)
      (ok (search "=>" (text-of buffer)))
      (setf (lem:current-buffer) agenda)
      (move-to-line (current-point) 2)
      (lem-org-mode::org-agenda-goto)
      (ok (eq buffer (lem:current-buffer)) "Return visits the entry")
      (ok (= 1 (line-number-at-point (current-point)))))))

(deftest test-prompt-export-and-misc
  (with-temp-org-file (file (lines "* One" "text" "#+NAME: blk" "#+begin_src sh" "echo hi" "#+end_src"))
    (let ((buffer (lem:find-file-buffer (uiop:native-namestring file))))
      (setf (lem:current-buffer) buffer)
      (with-answers ("h") (lem-org-mode::org-export-dispatch))
      (ok (probe-file (make-pathname :type "html" :defaults file)))
      (with-answers ("blk") (lem-org-mode::org-babel-goto-named-src-block))
      (ok (= 4 (line-number-at-point (current-point))) "the cursor is on the #+begin_src line of the named block")
      (move-to-line (current-point) 1)
      (with-answers ("One") (lem-org-mode::org-goto))
      (ok (= 1 (line-number-at-point (current-point)))))))
