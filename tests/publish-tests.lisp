(in-package :lem-org-mode/tests)

(defun put-file (path text)
  (ensure-directories-exist path)
  (with-open-file (out path :direction :output :if-exists :supersede :external-format :utf-8) (write-string text out)))

(deftest test-publish-project
  (let* ((root (uiop:ensure-directory-pathname (format nil "/tmp/org-publish-~D-~D" (get-universal-time) (random 100000))))
         (src (merge-pathnames "src/" root)) (out (merge-pathnames "out/" root)) (cache (merge-pathnames "cache/" root)))
    (put-file (merge-pathnames "index.org" src) (lines "#+TITLE: Home" "* Welcome" "see [[file:sub/page.org][page]] and [[file:img/p.png]]"))
    (put-file (merge-pathnames "sub/page.org" src) (lines "#+TITLE: Page" "* Content" "hello"))
    (put-file (merge-pathnames "private/secret.org" src) (lines "#+TITLE: Secret"))
    (put-file (merge-pathnames "img/p.png" src) "PNGDATA")
    (let* ((lem-org-mode::*org-publish-timestamp-directory* (uiop:native-namestring cache))
           (lem-org-mode:*org-publish-project-alist*
             `(("pages" :base-directory ,(uiop:native-namestring src) :base-extension "org"
                        :publishing-directory ,(uiop:native-namestring out) :recursive t :exclude "^private/"
                        :publishing-function org-html-publish-to-html :auto-sitemap t :sitemap-title "All pages"
                        :with-toc nil)
               ("images" :base-directory ,(uiop:native-namestring (merge-pathnames "img/" src)) :base-extension "png\\|jpg"
                         :publishing-directory ,(uiop:native-namestring (merge-pathnames "img/" out))
                         :publishing-function org-publish-attachment)
               ("site" :components ("pages" "images")))))
      (multiple-value-bind (published skipped) (lem-org-mode::org-publish-project "site")
        (ok (= 4 published) "index, page, sitemap and the image")
        (ok (= 0 skipped)))
      (let ((index (uiop:read-file-string (merge-pathnames "index.html" out))))
        (ok (search "<title>Home</title>" index))
        (ok (search "href=\"sub/page.html\"" index) "links between pages point at the published files")
        (ok (search "src=\"img/p.png\"" index))
        (ok (not (search "id=\"table-of-contents\"" index)) ":with-toc nil is honoured"))
      (ok (search "hello" (uiop:read-file-string (merge-pathnames "sub/page.html" out))))
      (ok (not (probe-file (merge-pathnames "private/secret.html" out))) "excluded files are not published")
      (ok (string= "PNGDATA" (uiop:read-file-string (merge-pathnames "img/p.png" out))) "attachments are copied")
      (let ((sitemap (uiop:read-file-string (merge-pathnames "sitemap.org" src))))
        (ok (search "#+TITLE: All pages" sitemap))
        (ok (search "[[file:sub/page.org][Page]]" sitemap)))
      (ok (probe-file (merge-pathnames "sitemap.html" out)) "the sitemap is published too")
      (multiple-value-bind (published skipped) (lem-org-mode::org-publish-project "site")
        (ok (= 0 published) "nothing changed")
        (ok (= 4 skipped)))
      (sleep 1.1)
      (put-file (merge-pathnames "sub/page.org" src) (lines "#+TITLE: Page" "* Content" "changed text"))
      (multiple-value-bind (published skipped) (lem-org-mode::org-publish-project "site")
        (ok (= 1 published) "only the changed file is published again")
        (ok (= 3 skipped)))
      (ok (search "changed text" (uiop:read-file-string (merge-pathnames "sub/page.html" out))))
      (multiple-value-bind (published) (lem-org-mode::org-publish-project "site" :force t)
        (ok (= 4 published) "force publishes everything"))
      (ok (signals (lem-org-mode::org-publish-project "nope") 'editor-error)))
    (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore)))
