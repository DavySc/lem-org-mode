(in-package :lem-org-mode/tests)

(deftest test-structure-template
  (let ((buffer (make-org-buffer (lines "text" "two"))))
    (setf (lem:current-buffer) buffer)
    (move-to-line (current-point) 1)
    (lem-org-mode::org-insert-structure-template (current-point) "q")
    (ok (string= (lines "#+begin_quote" "" "#+end_quote" "text" "two") (text-of buffer)))
    (ok (= 2 (line-number-at-point (current-point))) "the cursor is inside the block"))
  (let ((buffer (make-org-buffer (lines "<s"))))
    (setf (lem:current-buffer) buffer)
    (move-to-line (current-point) 1)
    (line-end (current-point))
    (ok (lem-org-mode::org-tempo-expand (current-point)))
    (ok (string= (lines "#+begin_src " "" "#+end_src") (text-of buffer)))
    (ok (= 2 (line-number-at-point (current-point))))))

(deftest test-list-editing
  (let ((buffer (make-org-buffer (lines "- a" "  - a1" "- b" "- c"))))
    (setf (lem:current-buffer) buffer)
    (move-to-line (current-point) 3)
    (lem-org-mode::org-indent-item (current-point) 2)
    (ok (string= (lines "- a" "  - a1" "  - b" "- c") (text-of buffer)))
    (lem-org-mode::org-indent-item (current-point) -2)
    (ok (string= (lines "- a" "  - a1" "- b" "- c") (text-of buffer)))
    (lem-org-mode::org-move-item (current-point) -1)
    (ok (string= (lines "- b" "- a" "  - a1" "- c") (text-of buffer)))
    (ok (= 1 (line-number-at-point (current-point))) "the cursor follows the item")
    (lem-org-mode::org-move-item (current-point) 1)
    (ok (string= (lines "- a" "  - a1" "- b" "- c") (text-of buffer)))
    (ok (= 3 (line-number-at-point (current-point)))))
  (let ((buffer (make-org-buffer (lines "1. a" "2. b" "3. c"))))
    (setf (lem:current-buffer) buffer)
    (move-to-line (current-point) 3)
    (lem-org-mode::org-move-item (current-point) -1)
    (ok (string= (lines "1. a" "2. c" "3. b") (text-of buffer)) "numbers are renumbered"))
  (let ((buffer (make-org-buffer (lines "- a" "plain line"))))
    (setf (lem:current-buffer) buffer)
    (move-to-line (current-point) 1)
    (lem-org-mode::org-cycle-list-bullet)
    (ok (string= (lines "+ a" "plain line") (text-of buffer)))
    (move-to-line (current-point) 2)
    (lem-org-mode::org-ctrl-c-dash)
    (ok (string= (lines "+ a" "- plain line") (text-of buffer)) "a plain line becomes an item")))

(deftest test-return-and-comment
  (let ((buffer (make-org-buffer (lines "| a | b |" "| c | d |"))))
    (setf (lem:current-buffer) buffer)
    (move-to-line (current-point) 1)
    (lem-org-mode::org-return)
    (ok (= 2 (line-number-at-point (current-point))) "RET in a table goes to the next row")
    (lem-org-mode::org-return)
    (ok (= 4 (buffer-nlines buffer)) "and makes a new row at the end"))
  (let ((buffer (make-org-buffer "plain")))
    (setf (lem:current-buffer) buffer)
    (line-end (current-point))
    (lem-org-mode::org-return)
    (ok (string= (format nil "plain~%") (text-of buffer)) "RET elsewhere is a newline"))
  (let ((buffer (make-org-buffer (lines "* TODO x"))))
    (setf (lem:current-buffer) buffer)
    (lem-org-mode::org-toggle-comment)
    (ok (search "* TODO COMMENT x" (text-of buffer)))))

(deftest test-timer
  (let ((lem-org-mode::*org-timer-start* nil) (lem-org-mode::*org-timer-paused* nil)
        (buffer (make-org-buffer "")))
    (setf (lem:current-buffer) buffer)
    (ok (signals (lem-org-mode::org-timer) 'editor-error) "no timer yet")
    (lem-org-mode::org-timer-start)
    (lem-org-mode::org-timer)
    (ok (search "0:00:0" (text-of buffer)))
    (lem-org-mode::org-timer-item)
    (ok (search ":: " (text-of buffer)))))
