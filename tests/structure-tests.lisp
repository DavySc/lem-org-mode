(in-package :lem-org-mode/tests)

(defun s-text (buffer) (text-of buffer))

(deftest test-copy-cut-paste-subtree
  (let ((buffer (make-org-buffer (lines "* A" "a body" "** A1" "* B" "b body"))))
    (setf (lem:current-buffer) buffer)
    (lem-org-mode::org-copy-subtree (line-point buffer 1))
    (lem-org-mode::org-paste-subtree (line-point buffer 4))
    (ok (string= (lines "* A" "a body" "** A1" "* B" "b body" "* A" "a body" "** A1") (s-text buffer)) "paste after B at its level")
    (lem-org-mode::org-cut-subtree (line-point buffer 1))
    (ok (string= (lines "* B" "b body" "* A" "a body" "** A1") (s-text buffer)))
    (lem-org-mode::org-paste-subtree (line-point buffer 1))
    (ok (string= (lines "* B" "b body" "* A" "a body" "** A1" "* A" "a body" "** A1") (s-text buffer)) "paste after the first subtree")
    ;; paste under a deeper heading lowers the pasted levels... a sibling of ** A1
    (let ((b2 (make-org-buffer (lines "* P" "** child"))))
      (setf lem-org-mode::*org-subtree-clipboard* (format nil "* moved~%** sub"))
      (lem-org-mode::org-paste-subtree (line-point b2 2))
      (ok (string= (lines "* P" "** child" "** moved" "*** sub") (s-text b2)) "levels adapt to the target"))))

(deftest test-archive-subtree
  (let* ((directory (uiop:ensure-directory-pathname (format nil "/tmp/org-archive-~D" (get-universal-time))))
         (file (merge-pathnames "work.org" directory)))
    (ensure-directories-exist directory)
    (with-open-file (out file :direction :output :if-exists :supersede) (write-string (lines "* Keep" "* TODO Old task :t:" "body") out))
    (let ((buffer (lem:find-file-buffer (uiop:native-namestring file))))
      (setf (lem:current-buffer) buffer)
      (let ((target (lem-org-mode::org-archive-subtree (line-point buffer 2))))
        (ok (string= (lines "* Keep") (s-text buffer)) "the subtree has left")
        (let ((archive (s-text target)))
          (ok (search "* TODO Old task :t:" archive))
          (ok (search ":ARCHIVE_TIME:" archive))
          (ok (search (format nil ":ARCHIVE_FILE: ~A" (uiop:native-namestring file)) archive))
          (ok (search ":ARCHIVE_TODO: TODO" archive)))
        (ok (probe-file (merge-pathnames "work.org_archive" directory)) "the archive file was saved")))
    (uiop:delete-directory-tree directory :validate t :if-does-not-exist :ignore)))

(deftest test-archive-under-heading
  (let ((buffer (make-org-buffer (lines "#+ARCHIVE: ::* Archive" "* Keep" "* Old" "text"))))
    (setf (lem:current-buffer) buffer)
    (lem-org-mode::org-archive-subtree (line-point buffer 3))
    (let ((text (s-text buffer)))
      (ok (search (lines "* Keep" "* Archive" "** Old") text) "the heading is created and the subtree is one level lower"))))

(deftest test-archive-tag-and-sibling
  (let ((buffer (make-org-buffer (lines "* A" "* B"))))
    (setf (lem:current-buffer) buffer)
    (lem-org-mode::org-toggle-archive-tag (line-point buffer 1))
    (ok (search ":ARCHIVE:" (line-string (line-point buffer 1))))
    (lem-org-mode::org-toggle-archive-tag (line-point buffer 1))
    (ok (not (search ":ARCHIVE:" (line-string (line-point buffer 1)))))
    (lem-org-mode::org-archive-to-sibling (line-point buffer 1))
    (ok (search "* B" (s-text buffer)))
    (ok (search "** A" (s-text buffer)) "A moved under an Archive heading")
    (ok (search "* Archive" (s-text buffer)))))

(deftest test-sort-entries-and-list
  (let ((buffer (make-org-buffer (lines "* Tasks" "** c" "** a" "*** a1" "** b"))))
    (setf (lem:current-buffer) buffer)
    (lem-org-mode::org-sort-entries (line-point buffer 1) #\a)
    (ok (string= (lines "* Tasks" "** a" "*** a1" "** b" "** c") (s-text buffer))))
  (let ((buffer (make-org-buffer (lines "- pear" "- apple" "- fig"))))
    (setf (lem:current-buffer) buffer)
    (lem-org-mode::org-sort-list (line-point buffer 1) #\a)
    (ok (string= (lines "- apple" "- fig" "- pear") (s-text buffer))))
  (let ((buffer (make-org-buffer (lines "| b | 2 |" "| a | 10 |" "| c | 1 |"))))
    (setf (lem:current-buffer) buffer)
    (let ((p (line-point buffer 1)))
      (setf (point-charpos p) 7)
      (lem-org-mode::org-sort-table p #\n))
    (ok (search "| c | " (line-string (line-point buffer 1))) "sorted by the second column")))

(deftest test-properties-and-dependencies
  (let ((buffer (make-org-buffer (lines "* P" ":PROPERTIES:" ":COLOR: red" ":END:" "** child" "** TODO other"))))
    (setf (lem:current-buffer) buffer)
    (ok (string= "red" (lem-org-mode::org-entry-get (line-point buffer 1) "COLOR")))
    (ok (null (lem-org-mode::org-entry-get (line-point buffer 5) "COLOR")))
    (ok (string= "red" (lem-org-mode::org-entry-get (line-point buffer 5) "COLOR" t)) "inherited")
    (lem-org-mode::org-entry-delete (line-point buffer 1) "COLOR")
    (ok (not (search "COLOR" (s-text buffer))))
    (ok (not (search ":PROPERTIES:" (s-text buffer))) "the empty drawer goes too"))
  (let ((buffer (make-org-buffer (lines "* TODO P" "** TODO one"))))
    (setf (lem:current-buffer) buffer)
    (let ((lem-org-mode::*org-enforce-todo-dependencies* t))
      (ok (signals (lem-org-mode:org-todo-change (line-point buffer 1) "DONE") 'editor-error))
      (lem-org-mode:org-todo-change (line-point buffer 2) "DONE")
      (lem-org-mode:org-todo-change (line-point buffer 1) "DONE")
      (ok (search "* DONE P" (s-text buffer))))))

(deftest test-navigation
  (let ((buffer (make-org-buffer (lines "* A" "a" "** A1" "a1" "* B" "b"))))
    (setf (lem:current-buffer) buffer)
    (move-to-line (current-point) 1)
    (lem-org-mode::org-next-visible-heading)
    (ok (= 3 (line-number-at-point (current-point))))
    (lem-org-mode::outline-up-heading)
    (ok (= 1 (line-number-at-point (current-point))))
    (lem-org-mode::org-forward-heading-same-level)
    (ok (= 5 (line-number-at-point (current-point))))
    (lem-org-mode::org-backward-heading-same-level)
    (ok (= 1 (line-number-at-point (current-point))))
    (ok (signals (lem-org-mode::org-backward-heading-same-level) 'editor-error))))

(deftest test-sparse-tree
  (let ((buffer (make-org-buffer (lines "* TODO a" "needle" "* TODO b" "* c"))))
    (setf (lem:current-buffer) buffer)
    (let ((entries (lem-org-mode::agenda-entries nil buffer)))
      (ok (= 3 (length entries)))
      (ok (search "L1" (car (lem-org-mode::sparse-record (first entries))))))))

(defun fold-count (buffer)
  (count-if (lambda (o) (lem:overlay-get o :fold)) (lem:buffer-overlays buffer)))

(deftest test-visibility
  (let ((buffer (make-org-buffer (lines "* A" "a" "** A1" "a1" "* B" "b"))))
    (setf (lem:current-buffer) buffer)
    (lem-org-mode::org-set-visibility buffer :overview)
    (ok (= 2 (fold-count buffer)) "overview folds each top-level entry")
    (lem-org-mode::org-set-visibility buffer :all)
    (ok (= 0 (fold-count buffer)))
    (lem-org-mode::org-set-visibility buffer :contents)
    (ok (= 3 (fold-count buffer)) "contents folds the text under every heading")
    (lem-org-mode::org-set-visibility buffer :all)
    (lem-org-mode::org-cycle-heading (line-point buffer 1))
    (ok (= 1 (fold-count buffer)) "first Tab folds")
    (lem-org-mode::org-cycle-heading (line-point buffer 1))
    (ok (= 1 (fold-count buffer)) "second Tab shows children: only the child is folded")
    (lem-org-mode::org-cycle-heading (line-point buffer 1))
    (ok (= 0 (fold-count buffer)) "third Tab shows everything")))

(deftest test-headings-in-blocks-are-text
  (let ((buffer (make-org-buffer (lines "* A" "#+begin_src sh" "* not a heading" "#+end_src" "* B" "#+begin_example" "** nor this" "#+end_example"))))
    (ok (eql 1 (lem-org-mode:org-heading-level (line-point buffer 1))))
    (ok (null (lem-org-mode:org-heading-level (line-point buffer 3))))
    (ok (eql 1 (lem-org-mode:org-heading-level (line-point buffer 5))))
    (ok (null (lem-org-mode:org-heading-level (line-point buffer 7))))
    (multiple-value-bind (start end) (lem-org-mode:org-subtree-bounds (line-point buffer 1))
      (ok (= 1 (line-number-at-point start)))
      (ok (= 5 (line-number-at-point end)) "the subtree of A runs over the fake heading"))
    (setf (lem:current-buffer) buffer)
    (lem-org-mode:org-shift-subtree (line-point buffer 1) 1)
    (ok (string= (lines "** A" "#+begin_src sh" "* not a heading" "#+end_src" "* B" "#+begin_example" "** nor this" "#+end_example") (text-of buffer))
        "promoting and demoting leave block contents alone")
    (insert-string (buffer-end-point buffer) "* C")
    (ok (eql 1 (lem-org-mode:org-heading-level (line-point buffer 9))) "the cache follows edits")))
