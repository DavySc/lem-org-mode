(in-package :lem-org-mode/tests)

(defmacro with-temp-org-file ((var text) &body body)
  `(let* ((directory (uiop:ensure-directory-pathname (format nil "/tmp/org-cap-~D-~D" (get-universal-time) (random 100000))))
          (,var (merge-pathnames "inbox.org" directory)))
     (ensure-directories-exist directory)
     (with-open-file (out ,var :direction :output :if-exists :supersede) (write-string ,text out))
     (unwind-protect (progn ,@body)
       (uiop:delete-directory-tree directory :validate t :if-does-not-exist :ignore))))

(deftest test-capture-string
  (with-temp-org-file (file (lines "* Tasks" "* Notes"))
    (let ((lem-org-mode:*org-capture-templates*
            `(("t" "Task" entry (file+headline ,(uiop:native-namestring file) "Tasks") "* TODO %i %?")
              ("j" "Journal" entry (file+datetree ,(uiop:native-namestring file)) "* %<%H>h %i")
              ("n" "Note" item (file+headline ,(uiop:native-namestring file) "Notes") "- %i"))))
      (multiple-value-bind (buffer line) (lem-org-mode:org-capture-string "t" "buy milk")
        (ok (search (lines "* Tasks" "** TODO buy milk " "* Notes") (text-of buffer)))
        (ok (= 2 line)))
      (lem-org-mode:org-capture-string "n" "remember")
      (ok (search (lines "* Notes" "- remember") (text-of (lem:find-file-buffer (uiop:native-namestring file)))))
      (lem-org-mode:org-capture-string "j" "wrote tests")
      (let ((text (text-of (lem:find-file-buffer (uiop:native-namestring file)))))
        (ok (search "*** " text) "a date tree was made")
        (ok (search "wrote tests" text))))))

(deftest test-refile
  (let ((buffer (make-org-buffer (lines "* Inbox" "** TODO move me" "body" "* Projects" "** P1" "* Later"))))
    (setf (lem:current-buffer) buffer)
    (let* ((entries (lem-org-mode::agenda-entries nil buffer))
           (target (find "Projects" entries :key (lambda (e) (getf e :title)) :test #'string=)))
      (lem-org-mode:org-refile (line-point buffer 2) target)
      (ok (string= (lines "* Inbox" "* Projects" "** P1" "** TODO move me" "body" "* Later") (text-of buffer))
          "moved to the end of the target, one level below it"))
    (let* ((entries (lem-org-mode::agenda-entries nil buffer))
           (target (find "Inbox" entries :key (lambda (e) (getf e :title)) :test #'string=)))
      (lem-org-mode:org-refile (line-point buffer 4) target :copy t)
      (ok (string= (lines "* Inbox" "** TODO move me" "body" "* Projects" "** P1" "** TODO move me" "body" "* Later") (text-of buffer))
          "copy keeps the original"))
    (let* ((entries (lem-org-mode::agenda-entries nil buffer))
           (target (find "Later" entries :key (lambda (e) (getf e :title)) :test #'string=)))
      (ok (signals (lem-org-mode:org-refile (line-point buffer 4) (find "Projects" entries :key (lambda (e) (getf e :title)) :test #'string=))
                   'editor-error)
          "a subtree cannot move into itself")
      target)))

(deftest test-capture-buffer
  (with-temp-org-file (file (lines "* Tasks"))
    (let ((lem-org-mode:*org-capture-templates*
            `(("t" "Task" entry (file+headline ,(uiop:native-namestring file) "Tasks") "* TODO %?" :immediate-finish t))))
      (setf (lem:current-buffer) (make-org-buffer "x"))
      (multiple-value-bind (text cursor) (lem-org-mode::capture-expand "* TODO %?" (lem-org-mode::capture-context))
        (ok (string= "* TODO " text))
        (ok (= 7 cursor))))))
