(in-package :lem-org-mode/tests)

(defun agenda-text-for (buffer spec)
  (setf (lem:current-buffer) buffer)
  (setf spec (list* :origin buffer spec))
  (multiple-value-bind (title records) (lem-org-mode::agenda-block-records spec)
    (let ((agenda (lem-org-mode::agenda-buffer title records spec)))
      (values (text-of agenda) agenda))))

(deftest test-agenda-views
  (let ((buffer (make-org-buffer (lines "* TODO [#A] Write :work:" "SCHEDULED: <2026-10-22 Thu>" "* TODO Pay :home:"
                                        "DEADLINE: <2026-10-25 Sun>" "* DONE Old :work:"))))
    (let ((text (agenda-text-for buffer '(:type :tags :match "work"))))
      (ok (search "Write" text))
      (ok (search "Old" text) "tag searches include finished entries"))
    (let ((text (agenda-text-for buffer '(:type :tags-todo :match "work"))))
      (ok (search "Write" text))
      (ok (not (search "Old" text))))
    (let ((text (agenda-text-for buffer '(:type :search :match "pay"))))
      (ok (search "Pay" text)))
    (let ((text (agenda-text-for buffer '(:type :alltodo :filter ((:tag "home" t))))))
      (ok (search "Pay" text))
      (ok (not (search "Write" text)) "the filter applies"))
    (let ((text (agenda-text-for buffer (list :type :agenda :span :day :start (lem-org-mode::date-day 2026 10 22)))))
      (ok (search "Thursday 22 October 2026" text)))))

(deftest test-agenda-navigation
  (let ((buffer (make-org-buffer (lines "* TODO Write" "SCHEDULED: <2026-10-22 Thu>"))))
    (multiple-value-bind (text agenda)
        (agenda-text-for buffer (list :type :agenda :span :week :start (lem-org-mode::date-day 2026 10 19)))
      (declare (ignore text))
      (setf (lem:current-buffer) agenda)
      (lem-org-mode::org-agenda-month-view)
      (ok (search "Month-agenda" (text-of agenda)))
      (ok (search "Scheduled:" (text-of agenda)) "the month contains the entry" )
      (lem-org-mode::org-agenda-later)
      (ok (not (search "Scheduled:" (text-of agenda))) "next month does not")
      (lem-org-mode::org-agenda-earlier)
      (ok (search "Scheduled:" (text-of agenda)))
      (lem-org-mode::org-agenda-log-mode)
      (ok (getf (lem:buffer-value agenda 'lem-org-mode::agenda-spec) :log)))))

(deftest test-agenda-act-on-entry
  (let ((buffer (make-org-buffer (lines "* TODO Write" "SCHEDULED: <2026-10-22 Thu>" "* TODO Pay"))))
    (setf (lem:current-buffer) buffer)
    (multiple-value-bind (text agenda) (agenda-text-for buffer '(:type :alltodo))
      (declare (ignore text))
      (setf (lem:current-buffer) agenda)
      (move-to-line (lem:current-point) 3)
      (ok (string= "Pay" (getf (lem-org-mode::agenda-entry-at-point) :title)))
      (lem-org-mode::call-at-entry (lem-org-mode::agenda-entry-at-point)
                                   (lambda (point) (lem-org-mode:org-todo-change point "DONE")))
      (ok (search "* DONE Pay" (text-of buffer)))
      (lem-org-mode::org-agenda-redo)
      (ok (not (search "Pay" (text-of agenda))) "the finished entry has left the todo list"))))

(deftest test-agenda-custom-command
  (let ((spec (lem-org-mode::custom-command-spec '("n" "Next" tags-todo "NEXT"))))
    (ok (equal '(:type :tags-todo :match "NEXT") spec)))
  (let ((spec (lem-org-mode::custom-command-spec '("b" "Block" ((agenda "" (:span :day)) (alltodo ""))))))
    (ok (= 2 (length (getf spec :blocks))))
    (ok (eq :day (getf (first (getf spec :blocks)) :span)))))
