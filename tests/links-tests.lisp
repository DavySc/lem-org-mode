(in-package :lem-org-mode/tests)

(defun open-link-in (buffer line column)
  (setf (lem:current-buffer) buffer)
  (let ((p (line-point buffer line)))
    (character-offset p column)
    (lem-org-mode::org-open-at-point p)))

(deftest test-open-internal-links
  (let ((buffer (make-org-buffer (lines "* TODO Intro :x:" ":PROPERTIES:" ":CUSTOM_ID: i1" ":ID: abc-1" ":END:"
                                        "Go to [[*Intro]] or [[#i1]] or [[target]] or [[id:abc-1]]." "A <<target>> here."
                                        "* Other"))))
    (setf (lem:current-buffer) buffer)
    (let ((urls '()))
      (open-link-in buffer 6 10)
      (ok (= 1 (line-number-at-point (current-point))) "heading link")
      (open-link-in buffer 6 25)
      (ok (= 1 (line-number-at-point (current-point))) "custom id link")
      (open-link-in buffer 6 36)
      (ok (= 7 (line-number-at-point (current-point))) "dedicated target")
      (setf (lem:current-buffer) buffer)
      (open-link-in buffer 6 49)
      (ok (= 1 (line-number-at-point (current-point))) "id link finds the entry in the open buffer")
      (let ((lem-org-mode::*org-url-open-function* (lambda (url) (push url urls))))
        (setf (lem:current-buffer) buffer)
        (let ((b2 (make-org-buffer "see https://example.com/x and [[mailto:a@b.c][mail]]")))
          (open-link-in b2 1 8)
          (open-link-in b2 1 40)))
      (ok (equal '("mailto:a@b.c" "https://example.com/x") urls) "urls go to the opener")
      (ok (signals (open-link-in buffer 8 2) 'editor-error) "no link on a plain line"))))

(deftest test-open-file-link
  (with-temp-org-file (file (lines "* One" "* Two" "text"))
    (let ((buffer (make-org-buffer (format nil "[[file:~A::*Two][two]] [[file:~A::3][line]]" (uiop:native-namestring file) (uiop:native-namestring file)))))
      (open-link-in buffer 1 5)
      (ok (= 2 (line-number-at-point (current-point))) "file link with heading search")
      (open-link-in buffer 1 (+ 3 (search "[[file" (text-of buffer) :from-end t)))
      (ok (= 3 (line-number-at-point (current-point))) "file link with line number"))))

(deftest test-store-and-insert-link
  (with-temp-org-file (file (lines "* TODO Heading [1/2] :t:" "body"))
    (let ((buffer (lem:find-file-buffer (uiop:native-namestring file))))
      (setf (lem:current-buffer) buffer)
      (let ((link (lem-org-mode::org-store-link (line-point buffer 2))))
        (ok (search "::*Heading" link) "the cookie, todo keyword and tags are not part of the search")
        (ok (not (search "TODO" link))))
      (ok (search "[[file:" lem-org-mode::*org-last-stored-link*))
      (let ((target (make-org-buffer "text ")))
        (setf (lem:current-buffer) target)
        (let ((p (line-point target 1)))
          (line-end p)
          (lem-org-mode::org-insert-link-text p "https://x.org" "X"))
        (ok (string= "text [[https://x.org][X]]" (text-of target)))
        (let ((p (line-point target 1)))
          (character-offset p 8)
          (lem-org-mode::org-insert-link-text p "https://y.org" nil))
        (ok (string= "text [[https://y.org]]" (text-of target)) "an existing link is replaced")))))

(deftest test-id-and-next-link
  (let ((buffer (make-org-buffer (lines "* Entry" "see [[a]] and [[b]]"))))
    (setf (lem:current-buffer) buffer)
    (let ((id (lem-org-mode::org-id-get-create (line-point buffer 1))))
      (ok (= 36 (length id)))
      (ok (string= id (lem-org-mode::org-id-get-create (line-point buffer 1))) "the same id the second time")
      (ok (search (format nil ":ID: ~A" id) (text-of buffer))))
    (ok (equal '(4 14) (mapcar (lambda (l) (getf l :start)) (lem-org-mode::links-in-line (line-string (line-point buffer 5))))))))

(deftest test-footnotes
  (let ((buffer (make-org-buffer (lines "* Notes" "A claim.[fn:1]" "Another.[fn:x]" "[fn:1] The source."))))
    (setf (lem:current-buffer) buffer)
    (move-to-line (current-point) 2)
    (character-offset (current-point) 10)
    (lem-org-mode::org-footnote-action (current-point))
    (ok (= 4 (line-number-at-point (current-point))) "from reference to definition")
    (lem-org-mode::org-footnote-action (current-point))
    (ok (= 2 (line-number-at-point (current-point))) "from definition back to the reference"))
  (let ((buffer (make-org-buffer (lines "text here." "more [fn:1] [fn:1] def"))))
    (setf (lem:current-buffer) buffer)
    (move-to-line (current-point) 1)
    (line-end (current-point))
    (lem-org-mode::org-footnote-action (current-point))
    (let ((text (text-of buffer)))
      (ok (search "text here.[fn:2]" text) "the new reference gets the next free number")
      (ok (search "* Footnotes" text))
      (ok (search "[fn:2] " text)))))
