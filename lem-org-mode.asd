(defsystem "lem-org-mode"
  :depends-on ("lem/core")
  :serial t
  :components ((:file "org-mode")
               (:file "timestamp")
               (:file "tasks-model")
               (:file "tasks")
               (:file "planning")
               (:file "structure")
               (:file "capture")
               (:file "links")
               (:file "tables")
               (:file "dblocks")
               (:file "agenda")
               (:file "babel-model")
               (:file "export")
               (:file "babel")))

(defsystem "lem-org-mode/tests"
  :depends-on ("lem-org-mode" "rove")
  :components ((:module "tests"
                :components ((:file "main")
                               (:file "babel2")
                               (:file "tasks-tests")
                               (:file "agenda-tests")
                               (:file "planning-tests")
                               (:file "structure-tests")
                               (:file "capture-tests")
                               (:file "links-tests")
                               (:file "tables-tests"))))
  :perform (test-op (op c) (symbol-call :rove '#:run c)))
